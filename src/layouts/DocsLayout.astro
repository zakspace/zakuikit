---
/**
 * Master documentation layout — theme boot (zero FOUC), glass header,
 * responsive sidebar with scrim, content column with optional TOC rail,
 * footer, search dialog and the client entry.
 *
 * Component styling comes from the ONE bundled library stylesheet
 * (`zak.css`, generated by scripts/build-standalone.mjs into public/ and
 * linked as a static asset). `docs.css` is imported here and is used for
 * documentation chrome only — it never ships inside the library bundle.
 */
import '../styles/docs.css';

import SiteHeader from '../components/SiteHeader.astro';
import SiteSidebar from '../components/SiteSidebar.astro';
import SiteFooter from '../components/SiteFooter.astro';
import DocToc from '../components/DocToc.astro';
import SearchDialog from '../components/SearchDialog.astro';

export interface TocItem {
  id: string;
  label: string;
}

interface Props {
  title?: string;
  desc?: string;
  activeCategory?: string;
  activeComponent?: string;
  toc?: TocItem[];
  landing?: boolean;
}

const {
  title,
  desc = 'ZAKUI — the enterprise design system: tokens, 167 components, accessibility guidance and native light/dark theming, documented with Astro.',
  activeCategory,
  activeComponent,
  toc = [],
  landing = false,
} = Astro.props;

const pageTitle = title ? `${title} · ZAKUI` : 'ZAKUI — Design System';
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://zak-ui.dev');
const hasToc = !landing && toc.length > 0;

const favicon =
  "/favicon.svg";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <!-- Single bundled library stylesheet (tokens + base + all components). -->
    <link rel="stylesheet" href="/zak.css" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f6f7fb" data-theme-color />
    <script is:inline>
      // Theme boot — runs before first paint so there is never a flash.
      (function () {
        try {
          var stored = localStorage.getItem('zak-theme');
          if (stored !== 'light' && stored !== 'dark') {
            stored = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          document.documentElement.setAttribute('data-theme', stored);
        } catch (error) {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader nav={!landing} />

    {landing ? (
      <main class="docs-main docs-main--landing" id="main"><slot /></main>
    ) : (
      <>
        <div class="docs-scrim" data-docs-scrim></div>
        <div class="docs-shell">
          <SiteSidebar activeCategory={activeCategory} activeComponent={activeComponent} />
          <main class="docs-main" id="main">
            {hasToc ? (
              <div class="docs-content-grid">
                <div class="docs-content"><slot /></div>
                <DocToc items={toc} />
              </div>
            ) : (
              <slot />
            )}
          </main>
        </div>
      </>
    )}

    <SiteFooter />
    <SearchDialog />

    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
