---
/**
 * Component page — the full documentation surface for one catalogue entry:
 * header, interactive playground, usage, props API + design tokens and
 * accessibility guidance, framed by previous/next navigation.
 *
 * The design-token table is derived at build time from the tokens referenced
 * by the demo CSS (when present) and the category stylesheet, ranked by how
 * often each token appears.
 */
import DocsLayout from '../../../layouts/DocsLayout.astro';
import tokensCss from '../../../styles/tokens.css?raw';
import layoutCss from '../../../styles/zak-layout.css?raw';
import buttonsCss from '../../../styles/zak-buttons.css?raw';
import formsCss from '../../../styles/zak-forms.css?raw';
import pickersCss from '../../../styles/zak-pickers.css?raw';
import displayCss from '../../../styles/zak-display.css?raw';
import gridCss from '../../../styles/zak-grid.css?raw';
import navigationCss from '../../../styles/zak-navigation.css?raw';
import feedbackCss from '../../../styles/zak-feedback.css?raw';
import mediaCss from '../../../styles/zak-media.css?raw';
import aiCss from '../../../styles/zak-ai.css?raw';
import DemoBlock from '../../../components/DemoBlock.astro';
import ExampleBlock from '../../../components/ExampleBlock.astro';
import PropTable from '../../../components/PropTable.astro';
import KeyTable from '../../../components/KeyTable.astro';
import { allComponents, findCategory, type Category, type ComponentEntry } from '../../../data/catalog';
import { getDemo } from '../../../demos/index';
import { fallbackA11y, fallbackProps, type DemoDef, type PropRow } from '../../../demos/types';
import { inlineCode } from '../../../lib/strings';
import { svgIcon } from '../../../data/icons';
import {
  paletteScales,
  semanticTokens,
  spacingScale,
  radiusScale,
  shadowScale,
  typeScale,
  breakpoints,
} from '../../../data/tokens';
import type { TocItem } from '../../../layouts/DocsLayout.astro';

export function getStaticPaths() {
  return allComponents.map((entry) => {
    const cat = findCategory(entry.category);
    const demo = getDemo(entry.slug);
    if (!cat) throw new Error(`Unknown category for ${entry.slug}: ${entry.category}`);
    if (!demo) throw new Error(`Missing demo for ${entry.category}/${entry.slug}`);
    return {
      params: { category: entry.category, component: entry.slug },
      props: { cat, comp: entry, demo },
    };
  });
}

interface Props {
  cat: Category;
  comp: ComponentEntry;
  demo: DemoDef;
}

const { cat, comp, demo } = Astro.props;

/* ---- Theme metadata -------------------------------------------------------- */
const statusClass: Record<string, string> = {
  stable: 'zak-badge--success',
  beta: 'zak-badge--primary',
  experimental: 'zak-badge--warning',
};
const statusLabel: Record<string, string> = {
  stable: 'Stable',
  beta: 'Beta',
  experimental: 'Experimental',
};
const badgeClass: Record<string, string> = {
  new: 'zak-badge--success',
  ai: 'zak-badge--primary',
  updated: 'zak-badge--info',
};
const badgeLabel: Record<string, string> = { new: 'New', ai: 'AI', updated: 'Updated' };

/* ---- Design tokens --------------------------------------------------------- */
const CATEGORY_CSS: Record<string, string> = {
  utilities: tokensCss,
  layout: layoutCss,
  buttons: buttonsCss,
  forms: formsCss,
  pickers: pickersCss,
  'data-display': displayCss,
  tables: displayCss,
  'data-grid': gridCss,
  navigation: navigationCss,
  feedback: feedbackCss,
  overlays: feedbackCss,
  disclosure: navigationCss,
  media: mediaCss,
  'data-visualization': mediaCss,
  ai: aiCss,
};

interface TokenMeta {
  light: string;
  dark: string;
  role: string;
}

const styleCss = CATEGORY_CSS[cat.slug] ?? tokensCss;

const tokenMeta = new Map<string, TokenMeta>();
for (const scale of paletteScales) {
  for (const shade of scale.shades) {
    tokenMeta.set(`${scale.tokenPrefix}-${shade.shade}`, {
      light: shade.value,
      dark: '—',
      role: `${scale.name} · shade ${shade.shade}`,
    });
  }
}
for (const token of semanticTokens) tokenMeta.set(token.token, { light: token.light, dark: token.dark, role: token.usage });
for (const token of spacingScale) tokenMeta.set(token.token, { light: token.value, dark: '—', role: 'Spacing step' });
for (const token of radiusScale) tokenMeta.set(token.token, { light: token.value, dark: '—', role: 'Corner radius' });
for (const token of shadowScale) tokenMeta.set(token.token, { light: '—', dark: '—', role: token.usage });
for (const token of typeScale) tokenMeta.set(token.token, { light: token.size, dark: '—', role: `${token.sample} · weight ${token.weight}` });
for (const token of breakpoints) tokenMeta.set(token.token, { light: token.value, dark: '—', role: token.usage });

function tokenFrequency(css: string): string[] {
  const counts = new Map<string, number>();
  for (const match of css.matchAll(/--zak-[a-z0-9-]+/g)) {
    counts.set(match[0], (counts.get(match[0]) ?? 0) + 1);
  }
  return [...counts.entries()].sort((a, b) => b[1] - a[1]).map(([token]) => token);
}

const demoTokens = demo.css ? [...new Set(demo.css.match(/--zak-[a-z0-9-]+/g) ?? [])] : [];
const tokens: string[] = [];
for (const token of [...demoTokens, ...tokenFrequency(styleCss)]) {
  if (!tokens.includes(token)) tokens.push(token);
  if (tokens.length >= 6) break;
}

const tokenRows: PropRow[] = tokens.map((token) => {
  const meta = tokenMeta.get(token);
  return [token, meta?.light ?? '—', meta?.dark ?? '—', meta?.role ?? 'Referenced by this category’s styles'];
});

/* ---- Content --------------------------------------------------------------- */
const propRows: PropRow[] = demo.props ?? fallbackProps(cat.slug);
const fallback = fallbackA11y(cat.slug);
const keyRows = demo.a11y?.keys ?? fallback.keys;
const ariaRows = demo.a11y?.aria ?? fallback.aria;
const notes = demo.notes ?? [];

const headerDesc = demo.desc ?? comp.desc;
const demoLead = demo.desc
  ? comp.desc
  : 'Live preview rendered from the exact markup shown in the code tabs — every prop is demonstrated with copy-ready HTML.';

const idx = allComponents.findIndex((entry) => entry.category === cat.slug && entry.slug === comp.slug);
const prev = idx > 0 ? allComponents[idx - 1] : undefined;
const next = idx < allComponents.length - 1 ? allComponents[idx + 1] : undefined;

const toc: TocItem[] = [
  { id: 'overview', label: 'Overview' },
  { id: 'demo', label: 'Demo' },
  ...(demo.examples?.length ? [{ id: 'examples', label: 'Examples' }] : []),
  { id: 'usage', label: 'Usage' },
  { id: 'props', label: 'Props API' },
  { id: 'accessibility', label: 'Accessibility' },
];

const usageHtml = inlineCode(
  `The HTML tab above is the complete markup for this pattern — every class is a plain CSS hook and behaviour is declared through \`data-zak-*\` attributes, so it drops into Astro, server-rendered templates or hand-written HTML alike. Colour, spacing and radius come from the token layer, so the component inherits light/dark values automatically.`,
);
const jsHtml = demo.js
  ? inlineCode(
      `The JS tab shows the native initialisation contract — a dependency-free ES module that wires the \`data-zak-*\` hooks with no framework runtime.`,
    )
  : demo.playground !== true
    ? inlineCode(`This pattern is pure markup and CSS — it needs no JavaScript at all.`)
    : '';

const infoI = svgIcon('info', 'zak-icon', 15);
const arrowI = svgIcon('arrow-right', 'zak-icon', 13);
---

<DocsLayout
  title={comp.name}
  desc={`${comp.name} — ${cat.name}. ${headerDesc}`}
  activeCategory={cat.slug}
  activeComponent={comp.slug}
  toc={toc}
>
  <header class="doc-header" id="overview">
    <div class="doc-header__meta">
      <a class="zak-badge zak-badge--primary" href={`/docs/${cat.slug}/`}>
        <Fragment set:html={svgIcon(cat.icon, 'zak-icon', 13)} />
        {cat.name}
      </a>
      <span class:list={['zak-badge', statusClass[comp.status]]}>{statusLabel[comp.status]}</span>
      {comp.badge && <span class:list={['zak-badge', badgeClass[comp.badge]]}>{badgeLabel[comp.badge]}</span>}
      <span class="zak-badge zak-badge--info">v{comp.since}</span>
    </div>
    <h1 class="doc-header__title">{comp.name}</h1>
    <p class="doc-header__desc">{headerDesc}</p>
  </header>

  <section class="doc-section" id="demo">
    <h2 class="doc-section__title">Demo</h2>
    <p class="doc-section__lead">{demoLead}</p>
    <DemoBlock demo={demo} slug={comp.slug} />
  </section>

  {demo.examples?.length && (
    <section class="doc-section" id="examples">
      <h2 class="doc-section__title">Examples</h2>
      <p class="doc-section__lead">
        One variant per card — the markup in each code tab is exactly what renders above it, so any single
        pattern can be copied without unpicking the combined demo.
      </p>
      {demo.examples.map((example, index) => (
        <ExampleBlock example={example} slug={comp.slug} index={index} />
      ))}
    </section>
  )}

  <section class="doc-section" id="usage">
    <h2 class="doc-section__title">Usage</h2>
    {notes.map((note) => (
      <div class="doc-callout">
        <Fragment set:html={infoI} />
        <span set:html={inlineCode(note)} />
      </div>
    ))}
    <p class="doc-p" set:html={usageHtml} />
    {jsHtml && <p class="doc-p" set:html={jsHtml} />}
  </section>

  <section class="doc-section" id="props">
    <h2 class="doc-section__title">Props API</h2>
    <PropTable rows={propRows} />
    {demo.showTokens === true && tokenRows.length > 0 && (
      <>
        <h3 class="doc-section__subtitle">Design tokens</h3>
        <p class="doc-p">
          The tokens this pattern consumes most, resolved for both themes. Values are the semantic layer —
          swap them once and every component follows.
        </p>
        <PropTable rows={tokenRows} head={['Token', 'Light', 'Dark', 'Role']} />
      </>
    )}
  </section>

  <section class="doc-section" id="accessibility">
    <h2 class="doc-section__title">Accessibility</h2>
    <h3 class="doc-section__subtitle">Keyboard interactions</h3>
    <KeyTable head={['Keys', 'Interaction']} rows={keyRows} />
    <h3 class="doc-section__subtitle">ARIA &amp; semantics</h3>
    <KeyTable head={['Attribute', 'Purpose']} rows={ariaRows} />
  </section>

  <nav class="doc-section" aria-label="Component navigation">
    <div class="cat-grid">
      {prev && (
        <a class="cat-card" href={`/docs/${prev.category}/${prev.slug}/`}>
          <span class="landing-stat__label">Previous · {prev.categoryName}</span>
          <span class="cat-card__name">{prev.name}</span>
          <span class="cat-card__desc">{prev.desc}</span>
        </a>
      )}
      {next && (
        <a class="cat-card" href={`/docs/${next.category}/${next.slug}/`}>
          <span class="landing-stat__label">Next · {next.categoryName}</span>
          <span class="cat-card__name">
            {next.name} <Fragment set:html={arrowI} />
          </span>
          <span class="cat-card__desc">{next.desc}</span>
        </a>
      )}
    </div>
  </nav>
</DocsLayout>
