.zak-pr-6 { padding-right: var(--zak-space-6); }

/* ============================================================
   5. BORDER UTILITIES
   ============================================================ */
.zak-border { border: 1px solid var(--zak-border); }
.zak-border-0 { border: 0; }
.zak-border-2 { border: 2px solid var(--zak-border); }
.zak-border-4 { border: 4px solid var(--zak-border); }
.zak-border-top { border-top: 1px solid var(--zak-border); }
.zak-border-top-0 { border-top: 0; }
.zak-border-bottom { border-bottom: 1px solid var(--zak-border); }
.zak-border-bottom-0 { border-bottom: 0; }
.zak-border-start { border-left: 1px solid var(--zak-border); }
.zak-border-start-0 { border-left: 0; }
.zak-border-end { border-right: 1px solid var(--zak-border); }
.zak-border-end-0 { border-right: 0; }

.zak-border-primary { border-color: var(--zak-color-primary); }
.zak-border-secondary { border-color: var(--zak-color-secondary); }
.zak-border-success { border-color: var(--zak-color-success); }
.zak-border-warning { border-color: var(--zak-color-warning); }
.zak-border-danger { border-color: var(--zak-color-danger); }
.zak-border-info { border-color: var(--zak-color-info); }
.zak-border-muted { border-color: var(--zak-text-muted); }

.zak-rounded-0 { border-radius: var(--zak-radius-none); }
.zak-rounded-sm { border-radius: var(--zak-radius-sm); }
.zak-rounded-md { border-radius: var(--zak-radius-md); }
.zak-rounded-lg { border-radius: var(--zak-radius-lg); }
.zak-rounded-xl { border-radius: var(--zak-radius-xl); }
.zak-rounded-2xl { border-radius: var(--zak-radius-2xl); }
.zak-rounded-3xl { border-radius: var(--zak-radius-3xl); }
.zak-rounded-full { border-radius: var(--zak-radius-full); }
.zak-rounded { border-radius: var(--zak-radius-md); }
.zak-rounded-top { border-top-left-radius: var(--zak-radius-lg); border-top-right-radius: var(--zak-radius-lg); }
.zak-rounded-bottom { border-bottom-left-radius: var(--zak-radius-lg); border-bottom-right-radius: var(--zak-radius-lg); }
.zak-rounded-start { border-top-left-radius: var(--zak-radius-lg); border-bottom-left-radius: var(--zak-radius-lg); }
.zak-rounded-end { border-top-right-radius: var(--zak-radius-lg); border-bottom-right-radius: var(--zak-radius-lg); }

/* ============================================================
   6. SHADOW UTILITIES
   ============================================================ */
.zak-shadow-none { box-shadow: var(--zak-shadow-none); }
.zak-shadow-sm { box-shadow: var(--zak-shadow-sm); }
.zak-shadow-md { box-shadow: var(--zak-shadow-md); }
.zak-shadow-lg { box-shadow: var(--zak-shadow-lg); }
.zak-shadow-xl { box-shadow: var(--zak-shadow-xl); }
.zak-shadow-2xl { box-shadow: var(--zak-shadow-2xl); }
.zak-shadow-inner { box-shadow: var(--zak-shadow-inner); }
.zak-shadow-xs { box-shadow: var(--zak-shadow-xs); }

/* ============================================================
   7. LAYOUT SYSTEM
   ============================================================ */

/* Container */
.zak-container {
  width: 100%;
  margin-right: auto;
  margin-left: auto;
  padding-right: var(--zak-space-4);
  padding-left: var(--zak-space-4);
}
.zak-container-fluid {
  width: 100%;
  margin-right: auto;
  margin-left: auto;
  padding-right: var(--zak-space-4);
  padding-left: var(--zak-space-4);
}
.zak-container-sm { max-width: 540px; }
.zak-container-md { max-width: 720px; }
.zak-container-lg { max-width: 960px; }
.zak-container-xl { max-width: 1140px; }
.zak-container-2xl { max-width: 1320px; }

/* Grid */
.zak-grid { display: grid; grid-template-columns: repeat(12, 1fr); gap: var(--zak-space-4); }
.zak-grid-cols-1 { grid-template-columns: repeat(1, 1fr); }
.zak-grid-cols-2 { grid-template-columns: repeat(2, 1fr); }
.zak-grid-cols-3 { grid-template-columns: repeat(3, 1fr); }
.zak-grid-cols-4 { grid-template-columns: repeat(4, 1fr); }
.zak-grid-cols-5 { grid-template-columns: repeat(5, 1fr); }
.zak-grid-cols-6 { grid-template-columns: repeat(6, 1fr); }
.zak-grid-cols-7 { grid-template-columns: repeat(7, 1fr); }
.zak-grid-cols-8 { grid-template-columns: repeat(8, 1fr); }
.zak-grid-cols-9 { grid-template-columns: repeat(9, 1fr); }
.zak-grid-cols-10 { grid-template-columns: repeat(10, 1fr); }
.zak-grid-cols-11 { grid-template-columns: repeat(11, 1fr); }
.zak-grid-cols-12 { grid-template-columns: repeat(12, 1fr); }
.zak-grid-cols-none { grid-template-columns: none; }

.zak-col-1 { grid-column: span 1 / span 1; }
.zak-col-2 { grid-column: span 2 / span 2; }
.zak-col-3 { grid-column: span 3 / span 3; }
.zak-col-4 { grid-column: span 4 / span 4; }
.zak-col-5 { grid-column: span 5 / span 5; }
.zak-col-6 { grid-column: span 6 / span 6; }
.zak-col-7 { grid-column: span 7 / span 7; }
.zak-col-8 { grid-column: span 8 / span 8; }
.zak-col-9 { grid-column: span 9 / span 9; }
.zak-col-10 { grid-column: span 10 / span 10; }
.zak-col-11 { grid-column: span 11 / span 11; }
.zak-col-12 { grid-column: span 12 / span 12; }
.zak-col-1-3 { grid-column: span 4 / span 4; }
.zak-col-2-3 { grid-column: span 8 / span 8; }
.zak-col-auto { grid-column: auto; }

/* Row — 12-column grid container (identical layout to .zak-grid) */
.zak-row { display: grid; grid-template-columns: repeat(12, 1fr); gap: var(--zak-space-4); }
.zak-col { grid-column: span 12 / span 12; min-width: 0; }

/* Grid item — child cell inside .zak-grid */
.zak-grid-item { min-width: 0; min-height: 0; }

/* Columns — CSS multi-column layout with .zak-column children */
.zak-columns { column-gap: var(--zak-space-4); }
.zak-column { break-inside: avoid; page-break-inside: avoid; }
.zak-columns-1 { column-count: 1; }
.zak-columns-2 { column-count: 2; }
.zak-columns-3 { column-count: 3; }
.zak-columns-4 { column-count: 4; }
.zak-columns-auto { column-count: auto; }

.zak-gap-0 { gap: 0; }
.zak-gap-1 { gap: var(--zak-space-1); }
.zak-gap-2 { gap: var(--zak-space-2); }
.zak-gap-3 { gap: var(--zak-space-3); }
.zak-gap-4 { gap: var(--zak-space-4); }
.zak-gap-5 { gap: var(--zak-space-5); }
.zak-gap-6 { gap: var(--zak-space-6); }
.zak-gap-8 { gap: var(--zak-space-8); }
.zak-gap-10 { gap: var(--zak-space-10); }

.zak-row-gap-0 { row-gap: 0; }
.zak-row-gap-1 { row-gap: var(--zak-space-1); }
.zak-row-gap-2 { row-gap: var(--zak-space-2); }
.zak-row-gap-3 { row-gap: var(--zak-space-3); }
.zak-row-gap-4 { row-gap: var(--zak-space-4); }
.zak-row-gap-5 { row-gap: var(--zak-space-5); }
.zak-row-gap-6 { row-gap: var(--zak-space-6); }
.zak-row-gap-8 { row-gap: var(--zak-space-8); }

.zak-col-gap-0 { column-gap: 0; }
.zak-col-gap-1 { column-gap: var(--zak-space-1); }
.zak-col-gap-2 { column-gap: var(--zak-space-2); }
.zak-col-gap-3 { column-gap: var(--zak-space-3); }
.zak-col-gap-4 { column-gap: var(--zak-space-4); }
.zak-col-gap-5 { column-gap: var(--zak-space-5); }
.zak-col-gap-6 { column-gap: var(--zak-space-6); }
.zak-col-gap-8 { column-gap: var(--zak-space-8); }

/* Flex */
.zak-flex { display: flex; }
.zak-inline-flex { display: inline-flex; }
.zak-flex-row { flex-direction: row; }
.zak-flex-row-reverse { flex-direction: row-reverse; }
.zak-flex-column { flex-direction: column; }
.zak-flex-column-reverse { flex-direction: column-reverse; }
.zak-flex-wrap { flex-wrap: wrap; }
.zak-flex-nowrap { flex-wrap: nowrap; }
.zak-flex-wrap-reverse { flex-wrap: wrap-reverse; }

.zak-flex-1 { flex: 1 1 0%; }
.zak-flex-auto { flex: 1 1 auto; }
.zak-flex-initial { flex: 0 1 auto; }
.zak-flex-none { flex: none; }
.zak-grow-0 { flex-grow: 0; }
.zak-grow-1 { flex-grow: 1; }
.zak-shrink-0 { flex-shrink: 0; }
.zak-shrink-1 { flex-shrink: 1; }

.zak-justify-start { justify-content: flex-start; }
.zak-justify-end { justify-content: flex-end; }
.zak-justify-center { justify-content: center; }
.zak-justify-between { justify-content: space-between; }
.zak-justify-around { justify-content: space-around; }
.zak-justify-evenly { justify-content: space-evenly; }

.zak-items-start { align-items: flex-start; }
.zak-items-end { align-items: flex-end; }
.zak-items-center { align-items: center; }
.zak-items-baseline { align-items: baseline; }
.zak-items-stretch { align-items: stretch; }

.zak-content-start { align-content: flex-start; }
.zak-content-end { align-content: flex-end; }
.zak-content-center { align-content: center; }
.zak-content-between { align-content: space-between; }
.zak-content-around { align-content: space-around; }
.zak-content-stretch { align-content: stretch; }

.zak-self-auto { align-self: auto; }
.zak-self-start { align-self: flex-start; }
.zak-self-end { align-self: flex-end; }
.zak-self-center { align-self: center; }
.zak-self-stretch { align-self: stretch; }

.zak-order-first { order: -9999; }
.zak-order-last { order: 9999; }
.zak-order-0 { order: 0; }
.zak-order-1 { order: 1; }
.zak-order-2 { order: 2; }
.zak-order-3 { order: 3; }
.zak-order-4 { order: 4; }
.zak-order-5 { order: 5; }

/* Stack / Box */
.zak-stack { display: flex; flex-direction: column; }
.zak-stack-xs { display: flex; flex-direction: column; gap: var(--zak-space-1); }
.zak-stack-sm { display: flex; flex-direction: column; gap: var(--zak-space-2); }
.zak-stack-md { display: flex; flex-direction: column; gap: var(--zak-space-4); }
.zak-stack-lg { display: flex; flex-direction: column; gap: var(--zak-space-6); }
.zak-stack-xl { display: flex; flex-direction: column; gap: var(--zak-space-8); }
.zak-stack-divided > * + * { border-top: 1px solid var(--zak-border); padding-top: var(--zak-space-4); margin-top: var(--zak-space-4); }
.zak-stack-vertical-sm { flex-direction: column; }
.zak-stack-1 { display: flex; flex-direction: column; gap: var(--zak-space-1); }
.zak-stack-2 { display: flex; flex-direction: column; gap: var(--zak-space-2); }
.zak-stack-3 { display: flex; flex-direction: column; gap: var(--zak-space-3); }
.zak-stack-4 { display: flex; flex-direction: column; gap: var(--zak-space-4); }
.zak-stack-5 { display: flex; flex-direction: column; gap: var(--zak-space-5); }
.zak-stack-6 { display: flex; flex-direction: column; gap: var(--zak-space-6); }
.zak-stack-8 { display: flex; flex-direction: column; gap: var(--zak-space-8); }
.zak-stack-10 { display: flex; flex-direction: column; gap: var(--zak-space-10); }

.zak-hstack { display: flex; flex-direction: row; align-items: center; gap: var(--zak-space-2); }
.zak-hstack-1 { display: flex; flex-direction: row; align-items: center; gap: var(--zak-space-1); }
.zak-hstack-2 { display: flex; flex-direction: row; align-items: center; gap: var(--zak-space-2); }
.zak-hstack-3 { display: flex; flex-direction: row; align-items: center; gap: var(--zak-space-3); }
.zak-hstack-4 { display: flex; flex-direction: row; align-items: center; gap: var(--zak-space-4); }
.zak-hstack-5 { display: flex; flex-direction: row; align-items: center; gap: var(--zak-space-5); }
.zak-hstack-6 { display: flex; flex-direction: row; align-items: center; gap: var(--zak-space-6); }
.zak-hstack-8 { display: flex; flex-direction: row; align-items: center; gap: var(--zak-space-8); }

.zak-box { display: flex; flex-direction: column; }
.zak-box-content { display: flex; flex-direction: column; flex: 1; }
.zak-box-bordered { border: 1px solid var(--zak-border); border-radius: var(--zak-radius-lg); padding: var(--zak-space-4); }
.zak-box-sm { padding: var(--zak-space-2); }
.zak-box-md { padding: var(--zak-space-4); }
.zak-box-lg { padding: var(--zak-space-6); }
.zak-box-xl { padding: var(--zak-space-8); }
.zak-shadow { box-shadow: var(--zak-shadow-md); }
.zak-hover-shadow { transition: box-shadow var(--zak-transition-fast); }
.zak-hover-shadow:hover { box-shadow: var(--zak-shadow-lg); }
.zak-hover-scale { transition: transform var(--zak-transition-fast); }
.zak-hover-scale:hover { transform: scale(1.04); }

/* Aspect ratio */
.zak-aspect-ratio { position: relative; width: 100%; }
.zak-aspect-ratio::before { content: ""; display: block; padding-top: 56.25%; }
.zak-aspect-ratio > * { position: absolute; top: 0; left: 0; right: 0; bottom: 0; width: 100%; height: 100%; object-fit: cover; }
.zak-aspect-ratio-1x1::before { padding-top: 100%; }
.zak-aspect-ratio-4x3::before { padding-top: 75%; }
.zak-aspect-ratio-16x9::before { padding-top: 56.25%; }
.zak-aspect-ratio-21x9::before { padding-top: 42.86%; }
.zak-aspect-ratio-4x9::before { padding-top: 225%; }
.zak-aspect-ratio-sm-1x1::before { padding-top: 100%; }
.zak-aspect-ratio-md-4x3::before { padding-top: 75%; }
.zak-aspect-ratio-lg-16x9::before { padding-top: 56.25%; }

/* ============================================================
   8. DISPLAY UTILITIES
   ============================================================ */
.zak-d-none { display: none; }
.zak-d-inline { display: inline; }
.zak-d-inline-block { display: inline-block; }
.zak-d-block { display: block; }
.zak-d-grid { display: grid; }
