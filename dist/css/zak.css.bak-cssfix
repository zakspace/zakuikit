/* ============================================================
   ZAKUIKit - Core CSS Framework
   Version: 1.0.0
   Pure CSS - No frameworks. No @import. No SCSS.
   ============================================================ */

/* ============================================================
   1. DESIGN TOKENS / CSS CUSTOM PROPERTIES
   ============================================================ */
:root {
  /* ---- Primary (blue) ---- */
  --zak-primary-50: #eff6ff;
  --zak-primary-100: #dbeafe;
  --zak-primary-200: #bfdbfe;
  --zak-primary-300: #93c5fd;
  --zak-primary-400: #60a5fa;
  --zak-primary-500: #3b82f6;
  --zak-primary-600: #2563eb;
  --zak-primary-700: #1d4ed8;
  --zak-primary-800: #1e40af;
  --zak-primary-900: #1e3a8a;
  --zak-primary-950: #172554;

  /* ---- Secondary (gray) ---- */
  --zak-secondary-50: #f9fafb;
  --zak-secondary-100: #f3f4f6;
  --zak-secondary-200: #e5e7eb;
  --zak-secondary-300: #d1d5db;
  --zak-secondary-400: #9ca3af;
  --zak-secondary-500: #6b7280;
  --zak-secondary-600: #4b5563;
  --zak-secondary-700: #374151;
  --zak-secondary-800: #1f2937;
  --zak-secondary-900: #111827;
  --zak-secondary-950: #030712;

  /* ---- Success (green) ---- */
  --zak-success-50: #f0fdf4;
  --zak-success-100: #dcfce7;
  --zak-success-200: #bbf7d0;
  --zak-success-300: #86efac;
  --zak-success-400: #4ade80;
  --zak-success-500: #22c55e;
  --zak-success-600: #16a34a;
  --zak-success-700: #15803d;
  --zak-success-800: #166534;
  --zak-success-900: #14532d;
  --zak-success-950: #052e16;

  /* ---- Warning (amber) ---- */
  --zak-warning-50: #fffbeb;
  --zak-warning-100: #fef3c7;
  --zak-warning-200: #fde68a;
  --zak-warning-300: #fcd34d;
  --zak-warning-400: #fbbf24;
  --zak-warning-500: #f59e0b;
  --zak-warning-600: #d97706;
  --zak-warning-700: #b45309;
  --zak-warning-800: #92400e;
  --zak-warning-900: #78350f;
  --zak-warning-950: #451a03;

  /* ---- Danger (red) ---- */
  --zak-danger-50: #fef2f2;
  --zak-danger-100: #fee2e2;
  --zak-danger-200: #fecaca;
  --zak-danger-300: #fca5a5;
  --zak-danger-400: #f87171;
  --zak-danger-500: #ef4444;
  --zak-danger-600: #dc2626;
  --zak-danger-700: #b91c1c;
  --zak-danger-800: #991b1b;
  --zak-danger-900: #7f1d1d;
  --zak-danger-950: #450a0a;

  /* ---- Info (cyan) ---- */
  --zak-info-50: #ecfeff;
  --zak-info-100: #cffafe;
  --zak-info-200: #a5f3fc;
  --zak-info-300: #67e8f9;
  --zak-info-400: #22d3ee;
  --zak-info-500: #06b6d4;
  --zak-info-600: #0891b2;
  --zak-info-700: #0e7490;
  --zak-info-800: #155e75;
  --zak-info-900: #164e63;
  --zak-info-950: #083344;

  /* ---- Neutral shades 50-950 ---- */
  --zak-neutral-50: #fafafa;
  --zak-neutral-100: #f5f5f5;
  --zak-neutral-200: #e5e5e5;
  --zak-neutral-300: #d4d4d4;
  --zak-neutral-400: #a3a3a3;
  --zak-neutral-500: #737373;
  --zak-neutral-600: #525252;
  --zak-neutral-700: #404040;
  --zak-neutral-800: #262626;
  --zak-neutral-900: #171717;
  --zak-neutral-950: #0a0a0a;

  /* ---- Semantic color aliases ---- */
  --zak-color-primary: var(--zak-primary-500);
  --zak-color-primary-hover: var(--zak-primary-600);
  --zak-color-primary-active: var(--zak-primary-700);
  --zak-color-primary-light: var(--zak-primary-50);
  --zak-color-primary-dark: var(--zak-primary-900);

  --zak-color-secondary: var(--zak-secondary-500);
  --zak-color-secondary-hover: var(--zak-secondary-600);
  --zak-color-secondary-active: var(--zak-secondary-700);

  --zak-color-success: var(--zak-success-500);
  --zak-color-success-hover: var(--zak-success-600);
  --zak-color-success-active: var(--zak-success-700);

  --zak-color-warning: var(--zak-warning-500);
  --zak-color-warning-hover: var(--zak-warning-600);
  --zak-color-warning-active: var(--zak-warning-700);

  --zak-color-danger: var(--zak-danger-500);
  --zak-color-danger-hover: var(--zak-danger-600);
  --zak-color-danger-active: var(--zak-danger-700);

  --zak-color-info: var(--zak-info-500);
  --zak-color-info-hover: var(--zak-info-600);
  --zak-color-info-active: var(--zak-info-700);

  /* ---- Surface & Background (Light) ---- */
  --zak-bg: #ffffff;
  --zak-bg-subtle: #f8fafc;
  --zak-surface: #ffffff;
  --zak-surface-hover: #f1f5f9;
  --zak-surface-active: #e2e8f0;
  --zak-surface-raised: #ffffff;
  --zak-surface-sunken: #f8fafc;
  --zak-surface-overlay: rgba(255, 255, 255, 0.8);

  /* ---- Text (Light) ---- */
  --zak-text: #1e293b;
  --zak-text-muted: #566378;
  --zak-text-subtle: #5d6b80;
  --zak-text-inverse: #ffffff;
  --zak-text-disabled: #cbd5e1;

  /* ---- Text color tier (700-level on light surfaces) ---- */
  --zak-text-primary: var(--zak-primary-700);
  --zak-text-primary-hover: var(--zak-primary-800);
  --zak-text-secondary: var(--zak-secondary-700);
  --zak-text-secondary-hover: var(--zak-secondary-800);
  --zak-text-success: var(--zak-success-700);
  --zak-text-success-hover: var(--zak-success-800);
  --zak-text-warning: var(--zak-warning-700);
  --zak-text-warning-hover: var(--zak-warning-800);
  --zak-text-danger: var(--zak-danger-700);
  --zak-text-danger-hover: var(--zak-danger-800);
  --zak-text-info: var(--zak-info-700);
  --zak-text-info-hover: var(--zak-info-800);

  /* ---- Rating ---- */
  --zak-rating-star: var(--zak-warning-600);

  /* ---- Border (Light) ---- */
  --zak-border: #e2e8f0;
  --zak-border-strong: #cbd5e1;
  --zak-border-subtle: #f1f5f9;

  /* ---- Typography ---- */
  --zak-font-sans: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans", sans-serif;
  --zak-font-mono: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, "Liberation Mono", monospace;
  --zak-font-serif: Georgia, Cambria, "Times New Roman", Times, serif;

  --zak-font-size-xs: 0.75rem;
  --zak-font-size-sm: 0.875rem;
  --zak-font-size-base: 1rem;
  --zak-font-size-lg: 1.125rem;
  --zak-font-size-xl: 1.25rem;
  --zak-font-size-2xl: 1.5rem;
  --zak-font-size-3xl: 1.875rem;
  --zak-font-size-4xl: 2.25rem;
  --zak-font-size-5xl: 3rem;

  --zak-line-height-tight: 1.25;
  --zak-line-height-snug: 1.375;
  --zak-line-height-normal: 1.5;
  --zak-line-height-relaxed: 1.625;
  --zak-line-height-loose: 2;

  --zak-font-weight-light: 300;
  --zak-font-weight-normal: 400;
  --zak-font-weight-medium: 500;
  --zak-font-weight-semibold: 600;
  --zak-font-weight-bold: 700;

  --zak-letter-spacing-tight: -0.025em;
  --zak-letter-spacing-normal: 0em;
  --zak-letter-spacing-wide: 0.025em;
  --zak-letter-spacing-wider: 0.05em;
  --zak-letter-spacing-widest: 0.1em;

  /* ---- Spacing scale ---- */
  --zak-space-0: 0;
  --zak-space-0-5: 0.125rem;
  --zak-space-1: 0.25rem;
  --zak-space-1-5: 0.375rem;
  --zak-space-2: 0.5rem;
  --zak-space-2-5: 0.625rem;
  --zak-space-3: 0.75rem;
  --zak-space-3-5: 0.875rem;
  --zak-space-4: 1rem;
  --zak-space-5: 1.25rem;
  --zak-space-6: 1.5rem;
  --zak-space-7: 1.75rem;
  --zak-space-8: 2rem;
  --zak-space-9: 2.25rem;
  --zak-space-10: 2.5rem;
  --zak-space-12: 3rem;
  --zak-space-14: 3.5rem;
  --zak-space-16: 4rem;
  --zak-space-20: 5rem;
  --zak-space-24: 6rem;
  --zak-space-28: 7rem;
  --zak-space-32: 8rem;

  /* ---- Border radius ---- */
  --zak-radius-none: 0;
  --zak-radius-sm: 0.25rem;
  --zak-radius-md: 0.375rem;
  --zak-radius-lg: 0.5rem;
  --zak-radius-xl: 0.75rem;
  --zak-radius-2xl: 1rem;
  --zak-radius-3xl: 1.5rem;
  --zak-radius-full: 9999px;

  /* ---- Shadows ---- */
  --zak-shadow-xs: 0 1px 2px 0 rgb(0 0 0 / 0.05);
  --zak-shadow-sm: 0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1);
  --zak-shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
  --zak-shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
  --zak-shadow-xl: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1);
  --zak-shadow-2xl: 0 25px 50px -12px rgb(0 0 0 / 0.25);
  --zak-shadow-inner: inset 0 2px 4px 0 rgb(0 0 0 / 0.05);
  --zak-shadow-none: 0 0 #0000;

  /* ---- Z-index scale ---- */
  --zak-z-dropdown: 1000;
  --zak-z-sticky: 1020;
  --zak-z-fixed: 1030;
  --zak-z-backdrop: 1040;
  --zak-z-modal: 1050;
  --zak-z-popover: 1060;
  --zak-z-tooltip: 1070;
  --zak-z-toast: 1080;
  --zak-z-fab: 1090;
  --zak-z-top: 9999;
  --zak-z-overlay: 900;
  --zak-z-offcanvas: 1045;

  /* ---- Transitions ---- */
  --zak-transition-fast: 150ms cubic-bezier(0.4, 0, 0.2, 1);
  --zak-transition-base: 200ms cubic-bezier(0.4, 0, 0.2, 1);
  --zak-transition-slow: 300ms cubic-bezier(0.4, 0, 0.2, 1);
  --zak-transition-slower: 500ms cubic-bezier(0.4, 0, 0.2, 1);

  --zak-bg-secondary: #f8fafc;
  --zak-border-color: var(--zak-border);
  --zak-surface-muted: rgba(0, 0, 0, 0.02);
  --zak-tooltip-bg: #0f172a;
  --zak-tooltip-text: #ffffff;

  /* ---- Focus ring ---- */
  --zak-focus-ring: 0 0 0 3px rgba(59, 130, 246, 0.4);
  --zak-focus-ring-color: rgba(59, 130, 246, 0.4);

  /* ---- Overlays ---- */
  --zak-backdrop-bg: rgba(15, 23, 42, 0.5);
  --zak-overlay-bg: rgba(0, 0, 0, 0.4);
}

/* ============================================================
   DARK THEME TOKENS
   ============================================================ */
[data-theme="dark"] {
  --zak-bg: #0f172a;
  --zak-bg-subtle: #1e293b;
  --zak-surface: #1e293b;
  --zak-surface-hover: #334155;
  --zak-surface-active: #475569;
  --zak-surface-raised: #1e293b;
  --zak-surface-sunken: #0f172a;
  --zak-surface-overlay: rgba(30, 41, 59, 0.8);

  --zak-text: #f1f5f9;
  --zak-text-muted: #a5b2c4;
  --zak-text-subtle: #94a3b8;
  --zak-text-inverse: #0f172a;
  --zak-text-disabled: #64748b;

  /* ---- Text color tier (400-level on dark surfaces) ---- */
  --zak-text-primary: var(--zak-primary-400);
  --zak-text-primary-hover: var(--zak-primary-300);
  --zak-text-secondary: var(--zak-secondary-400);
  --zak-text-secondary-hover: var(--zak-secondary-300);
  --zak-text-success: var(--zak-success-400);
  --zak-text-success-hover: var(--zak-success-300);
  --zak-text-warning: var(--zak-warning-400);
  --zak-text-warning-hover: var(--zak-warning-300);
  --zak-text-danger: var(--zak-danger-400);
  --zak-text-danger-hover: var(--zak-danger-300);
  --zak-text-info: var(--zak-info-400);
  --zak-text-info-hover: var(--zak-info-300);

  /* ---- Rating ---- */
  --zak-rating-star: var(--zak-warning-400);

  --zak-border: #334155;
  --zak-border-strong: #475569;
  --zak-border-subtle: #1e293b;

  --zak-shadow-xs: 0 1px 2px 0 rgb(0 0 0 / 0.4);
  --zak-shadow-sm: 0 1px 3px 0 rgb(0 0 0 / 0.4), 0 1px 2px -1px rgb(0 0 0 / 0.4);
  --zak-shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.4), 0 2px 4px -2px rgb(0 0 0 / 0.4);
  --zak-shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.5), 0 4px 6px -4px rgb(0 0 0 / 0.4);
  --zak-shadow-xl: 0 20px 25px -5px rgb(0 0 0 / 0.5), 0 8px 10px -6px rgb(0 0 0 / 0.5);
  --zak-shadow-2xl: 0 25px 50px -12px rgb(0 0 0 / 0.6);
  --zak-shadow-inner: inset 0 2px 4px 0 rgb(0 0 0 / 0.4);

  --zak-backdrop-bg: rgba(0, 0, 0, 0.7);
  --zak-overlay-bg: rgba(0, 0, 0, 0.6);

  --zak-focus-ring: 0 0 0 3px rgba(96, 165, 250, 0.4);
  --zak-focus-ring-color: rgba(96, 165, 250, 0.4);

  --zak-color-primary: var(--zak-primary-400);
  --zak-color-primary-hover: var(--zak-primary-300);
  --zak-color-primary-active: var(--zak-primary-500);
  --zak-color-secondary: var(--zak-secondary-400);
  --zak-color-success: var(--zak-success-400);
  --zak-color-warning: var(--zak-warning-400);
  --zak-color-danger: var(--zak-danger-400);
  --zak-color-info: var(--zak-info-400);
}

/* ============================================================
   2. CSS RESET / NORMALIZE
   ============================================================ */
*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  -webkit-text-size-adjust: 100%;
  -moz-text-size-adjust: 100%;
  text-size-adjust: 100%;
  tab-size: 4;
  font-family: var(--zak-font-sans);
  line-height: var(--zak-line-height-normal);
  -webkit-tap-highlight-color: transparent;
}

body {
  margin: 0;
  min-height: 100vh;
  background-color: var(--zak-bg);
  color: var(--zak-text);
  font-family: var(--zak-font-sans);
  font-size: var(--zak-font-size-base);
  line-height: var(--zak-line-height-normal);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  transition: background-color var(--zak-transition-slow), color var(--zak-transition-slow);
}

h1, h2, h3, h4, h5, h6 { font-size: inherit; font-weight: inherit; }
a { color: inherit; text-decoration: none; }
b, strong { font-weight: bolder; }
small { font-size: 0.875em; }
img, svg, video, canvas, audio, iframe, embed, object { display: block; vertical-align: middle; }
img, video { max-width: 100%; height: auto; }
button, input, optgroup, select, textarea { font: inherit; color: inherit; margin: 0; padding: 0; border: 0; background: none; }
button, [type="button"], [type="reset"], [type="submit"] { cursor: pointer; -webkit-appearance: button; appearance: button; }
button:disabled, [disabled] { cursor: not-allowed; }
hr { border: 0; border-top: 1px solid var(--zak-border); height: 0; margin-top: var(--zak-space-4); margin-bottom: var(--zak-space-4); overflow: visible; }
ol, ul { list-style: none; }
table { border-collapse: collapse; border-spacing: 0; }
fieldset { min-width: 0; }
code, kbd, samp, pre { font-family: var(--zak-font-mono); font-size: 1em; }
[hidden] { display: none !important; }
::selection { background-color: var(--zak-primary-200); color: var(--zak-primary-900); }
[data-theme="dark"] ::selection { background-color: var(--zak-primary-800); color: var(--zak-primary-100); }
*:focus-visible { outline: 2px solid var(--zak-color-primary); outline-offset: 2px; }

/* Scrollbar */
* { scrollbar-width: thin; scrollbar-color: var(--zak-border-strong) transparent; }
*::-webkit-scrollbar { width: 8px; height: 8px; }
*::-webkit-scrollbar-track { background: transparent; }
*::-webkit-scrollbar-thumb { background-color: var(--zak-border-strong); border-radius: 9999px; }
*::-webkit-scrollbar-thumb:hover { background-color: var(--zak-text-subtle); }

/* ============================================================
   3. TYPOGRAPHY
   ============================================================ */
h1, .zak-h1 { font-size: var(--zak-font-size-5xl); }
h2, .zak-h2 { font-size: var(--zak-font-size-4xl); }
h3, .zak-h3 { font-size: var(--zak-font-size-3xl); }
h4, .zak-h4 { font-size: var(--zak-font-size-2xl); }
h5, .zak-h5 { font-size: var(--zak-font-size-xl); }
h6, .zak-h6 { font-size: var(--zak-font-size-lg); }
h1, h2, h3, h4, h5, h6, .zak-h1, .zak-h2, .zak-h3, .zak-h4, .zak-h5, .zak-h6 {
  font-family: var(--zak-font-sans);
  font-weight: var(--zak-font-weight-semibold);
  line-height: var(--zak-line-height-tight);
  color: var(--zak-text);
  margin: 0;
  margin-bottom: var(--zak-space-3);
}

.zak-display-1 { font-size: 4rem; font-weight: var(--zak-font-weight-bold); line-height: var(--zak-line-height-tight); letter-spacing: var(--zak-letter-spacing-tight); }
.zak-display-2 { font-size: 3.5rem; font-weight: var(--zak-font-weight-bold); line-height: var(--zak-line-height-tight); letter-spacing: var(--zak-letter-spacing-tight); }
.zak-display-3 { font-size: 3rem; font-weight: var(--zak-font-weight-bold); line-height: var(--zak-line-height-tight); }
.zak-display-4 { font-size: 2.5rem; font-weight: var(--zak-font-weight-bold); line-height: var(--zak-line-height-tight); }
.zak-display-5 { font-size: 2rem; font-weight: var(--zak-font-weight-bold); line-height: var(--zak-line-height-tight); }
.zak-display-6 { font-size: 1.5rem; font-weight: var(--zak-font-weight-semibold); line-height: var(--zak-line-height-tight); }

.zak-lead { font-size: var(--zak-font-size-xl); font-weight: var(--zak-font-weight-light); line-height: var(--zak-line-height-relaxed); color: var(--zak-text-muted); }

/* Font sizes */
.zak-fs-xs { font-size: var(--zak-font-size-xs); }
.zak-fs-sm { font-size: var(--zak-font-size-sm); }
.zak-fs-base { font-size: var(--zak-font-size-base); }
.zak-fs-lg { font-size: var(--zak-font-size-lg); }
.zak-fs-xl { font-size: var(--zak-font-size-xl); }
.zak-fs-2xl { font-size: var(--zak-font-size-2xl); }
.zak-fs-3xl { font-size: var(--zak-font-size-3xl); }
.zak-fs-4xl { font-size: var(--zak-font-size-4xl); }
.zak-fs-5xl { font-size: var(--zak-font-size-5xl); }

/* Weights */
.zak-fw-light { font-weight: var(--zak-font-weight-light); }
.zak-fw-normal { font-weight: var(--zak-font-weight-normal); }
.zak-fw-medium { font-weight: var(--zak-font-weight-medium); }
.zak-fw-semibold { font-weight: var(--zak-font-weight-semibold); }
.zak-fw-bold { font-weight: var(--zak-font-weight-bold); }

/* Text colors */
.zak-text-primary { color: var(--zak-text-primary); }
.zak-text-secondary { color: var(--zak-text-secondary); }
.zak-text-success { color: var(--zak-text-success); }
.zak-text-warning { color: var(--zak-text-warning); }
.zak-text-danger { color: var(--zak-text-danger); }
.zak-text-info { color: var(--zak-text-info); }
.zak-text-muted { color: var(--zak-text-muted); }
.zak-text-subtle { color: var(--zak-text-subtle); }
.zak-text-inverse { color: var(--zak-text-inverse); }
.zak-text-body { color: var(--zak-text); }

/* Alignment */
.zak-text-start { text-align: left; }
.zak-text-center { text-align: center; }
.zak-text-end { text-align: right; }
.zak-text-justify { text-align: justify; }

/* Transform */
.zak-lowercase { text-transform: lowercase; }
.zak-uppercase { text-transform: uppercase; }
.zak-capitalize { text-transform: capitalize; }

/* Truncation / wrap */
.zak-text-truncate { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.zak-text-wrap { white-space: normal; }
.zak-text-nowrap { white-space: nowrap; }
.zak-text-break { overflow-wrap: break-word; word-break: break-word; }
.zak-text-decoration-none { text-decoration: none; }
.zak-text-underline { text-decoration: underline; }
.zak-text-line-through { text-decoration: line-through; }

/* Font family */
.zak-font-sans { font-family: var(--zak-font-sans); }
.zak-font-mono { font-family: var(--zak-font-mono); }
.zak-font-serif { font-family: var(--zak-font-serif); }

/* Line height */
.zak-lh-none { line-height: 1; }
.zak-lh-tight { line-height: var(--zak-line-height-tight); }
.zak-lh-snug { line-height: var(--zak-line-height-snug); }
.zak-lh-normal { line-height: var(--zak-line-height-normal); }
.zak-lh-relaxed { line-height: var(--zak-line-height-relaxed); }
.zak-lh-loose { line-height: var(--zak-line-height-loose); }

/* Letter spacing */
.zak-tracking-tight { letter-spacing: var(--zak-letter-spacing-tight); }
.zak-tracking-normal { letter-spacing: var(--zak-letter-spacing-normal); }
.zak-tracking-wide { letter-spacing: var(--zak-letter-spacing-wide); }
.zak-tracking-wider { letter-spacing: var(--zak-letter-spacing-wider); }
.zak-tracking-widest { letter-spacing: var(--zak-letter-spacing-widest); }

/* Blockquote, code, kbd, mark, pre */
.zak-blockquote {
  border-left: 4px solid var(--zak-color-primary);
  padding: var(--zak-space-4);
  margin: var(--zak-space-4) 0;
  font-style: italic;
  color: var(--zak-text-muted);
  background-color: var(--zak-bg-subtle);
  border-radius: 0 var(--zak-radius-lg) var(--zak-radius-lg) 0;
}
code {
  font-family: var(--zak-font-mono);
  font-size: 0.875em;
  background-color: var(--zak-bg-subtle);
  border: 1px solid var(--zak-border);
  border-radius: var(--zak-radius-sm);
  padding: 0.1em 0.4em;
  color: var(--zak-danger-600);
}
[data-theme="dark"] code { color: var(--zak-danger-400); }
pre {
  font-family: var(--zak-font-mono);
  font-size: var(--zak-font-size-sm);
  background-color: var(--zak-bg-subtle);
  border: 1px solid var(--zak-border);
  border-radius: var(--zak-radius-lg);
  padding: var(--zak-space-4);
  overflow-x: auto;
  line-height: var(--zak-line-height-relaxed);
}
pre code { background: none; border: 0; padding: 0; color: inherit; font-size: inherit; }
kbd {
  font-family: var(--zak-font-mono);
  font-size: 0.75em;
  background-color: var(--zak-bg-subtle);
  border: 1px solid var(--zak-border-strong);
  border-bottom-width: 2px;
  border-radius: var(--zak-radius-sm);
  padding: 0.1em 0.4em;
}
mark { background-color: var(--zak-warning-100); color: var(--zak-warning-900); padding: 0 0.2em; border-radius: var(--zak-radius-sm); }
[data-theme="dark"] mark { background-color: var(--zak-warning-900); color: var(--zak-warning-100); }

/* Lists */
.zak-list-disc { list-style-type: disc; padding-left: var(--zak-space-6); }
.zak-list-decimal { list-style-type: decimal; padding-left: var(--zak-space-6); }
.zak-list-circle { list-style-type: circle; padding-left: var(--zak-space-6); }
.zak-list-square { list-style-type: square; padding-left: var(--zak-space-6); }
.zak-list-none { list-style: none; }
.zak-list-inside { list-style-position: inside; padding-left: 0; }

