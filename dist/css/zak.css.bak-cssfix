/* ============================================================
   64. UTILITY MISC / HELPERS
   ============================================================ */
.zak-ratio { position: relative; width: 100%; }
.zak-ratio::before { content: ""; display: block; }
.zak-ratio-1x1::before { padding-top: 100%; }
.zak-ratio-4x3::before { padding-top: 75%; }
.zak-ratio-16x9::before { padding-top: 56.25%; }
.zak-ratio-21x9::before { padding-top: 42.8571428571%; }
.zak-ratio > * { position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; }

.zak-object-cover { object-fit: cover; }
.zak-obj-contain { object-fit: contain; }
.zak-obj-fill { object-fit: fill; }
.zak-obj-none { object-fit: none; }
.zak-obj-scale-down { object-fit: scale-down; }

.zak-position-center { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); }
.zak-center { display: flex; align-items: center; justify-content: center; }
.zak-visually-hidden {
  position: absolute;
  width: 1px;
  height: 1px;
  margin: -1px;
  padding: 0;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}
.zak-text-reset { font-size: 1em; font-weight: normal; color: inherit; }
.zak-link { color: inherit; text-decoration: underline; cursor: pointer; }
.zak-link-primary { color: var(--zak-text-primary); text-decoration: none; }
.zak-link-primary:hover { color: var(--zak-text-primary-hover); text-decoration: underline; }
.zak-link-muted { color: var(--zak-text-muted); }
.zak-link-muted:hover { color: var(--zak-text); }
.zak-divider { display: flex; align-items: center; gap: var(--zak-space-3); color: var(--zak-text-subtle); font-size: var(--zak-font-size-xs); }
.zak-divider::before, .zak-divider::after { content: ""; flex: 1; height: 1px; background-color: var(--zak-border); }
.zak-divider-vertical { width: 1px; height: 1.5em; background-color: var(--zak-border); }
.zak-sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
.zak-notch { position: relative; }

.zak-ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.zak-text-gradient {
  background: linear-gradient(135deg, var(--zak-primary-500), var(--zak-info-500));
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  color: transparent;
}

.zak-sticky-top { position: sticky; top: 0; z-index: var(--zak-z-sticky); }
.zak-sticky-bottom { position: sticky; bottom: 0; z-index: var(--zak-z-sticky); }
.zak-fixed-top { position: fixed; top: 0; left: 0; right: 0; z-index: var(--zak-z-fixed); }
.zak-fixed-bottom { position: fixed; bottom: 0; left: 0; right: 0; z-index: var(--zak-z-fixed); }

.zak-text-shadow { text-shadow: 0 1px 2px rgba(0, 0, 0, 0.1); }
.zak-no-scrollbar { scrollbar-width: none; -ms-overflow-style: none; }
.zak-no-scrollbar::-webkit-scrollbar { display: none; }

.zak-hover-lift { transition: transform var(--zak-transition-base), box-shadow var(--zak-transition-base); }
.zak-hover-lift:hover { transform: translateY(-2px); box-shadow: var(--zak-shadow-md); }
.zak-hover-zoom { transition: transform var(--zak-transition-base); }
.zak-hover-zoom:hover { transform: scale(1.05); }

.zak-muted { color: var(--zak-text-muted); }
.zak-strong { font-weight: var(--zak-font-weight-semibold); }
.zak-em { font-style: italic; }
.zak-hidden { display: none; }

/* Reduced motion */
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}

/* ============================================================
   65. ZAKUIKIT - END OF FRAMEWORK
   ============================================================ */

/* ============================================================
   97. DEMO / CONSOLIDATED COMPONENT STYLES (from docs pages)
   ============================================================ */


.zak-ai-avatar{display:inline-flex;align-items:center;justify-content:center;border-radius:0.5rem;background:linear-gradient(135deg,#6366f1,#8b5cf6);color:#fff;flex-shrink:0;position:relative}
.zak-ai-avatar svg{width:1em;height:1em}
.zak-ai-avatar-xs{width:1.5rem;height:1.5rem;font-size:0.75rem;border-radius:0.375rem}
.zak-ai-avatar-sm{width:2rem;height:2rem;font-size:0.875rem}
.zak-ai-avatar-md{width:2.5rem;height:2.5rem;font-size:1rem}
.zak-ai-avatar-lg{width:3.5rem;height:3.5rem;font-size:1.375rem;border-radius:0.75rem}
.zak-ai-avatar-xl{width:5rem;height:5rem;font-size:2rem;border-radius:1rem}
.zak-ai-avatar-round{border-radius:50%}
.zak-ai-avatar-gradient-blue{background:linear-gradient(135deg,#0ea5e9,#6366f1)}
.zak-ai-avatar-gradient-green{background:linear-gradient(135deg,#10b981,#06b6d4)}
.zak-ai-avatar-gradient-orange{background:linear-gradient(135deg,#f59e0b,#ef4444)}
.zak-ai-avatar-gradient-pink{background:linear-gradient(135deg,#ec4899,#8b5cf6)}
.zak-ai-avatar-status{position:absolute;bottom:-2px;right:-2px;width:0.75rem;height:0.75rem;border-radius:50%;border:2px solid var(--zak-bg,#fff)}
.zak-ai-avatar-status.thinking{background:#f59e0b;animation:avatar-pulse 1.5s ease-in-out infinite}
.zak-ai-avatar-status.generating{background:#6366f1;animation:avatar-pulse 1s ease-in-out infinite}
.zak-ai-avatar-status.online{background:#10b981}
.zak-ai-avatar-status.offline{background:#94a3b8}
@keyframes avatar-pulse {
  0%,100%{opacity:1}
  50%{opacity:0.5}
}
.zak-ai-avatar-lg .zak-ai-avatar-status{width:1rem;height:1rem;bottom:0;right:0}
.zak-ai-avatar-xl .zak-ai-avatar-status{width:1.25rem;height:1.25rem;bottom:2px;right:2px}
.zak-ai-avatar-ring{box-shadow:0 0 0 3px rgba(99,102,241,0.2)}
.zak-ai-avatar-group{display:flex}
.zak-ai-avatar-group .zak-ai-avatar{margin-left:-0.5rem;border:2px solid var(--zak-bg,#fff)}
.zak-ai-avatar-group .zak-ai-avatar:first-child{margin-left:0}
.zak-ai-avatar-group .zak-ai-avatar-lg{margin-left:-0.75rem}
.zak-ai-avatar-in-chat{display:flex;align-items:center;gap:0.625rem;padding:0.5rem 0}
.zak-ai-avatar-in-chat-info{display:flex;flex-direction:column}
.zak-ai-avatar-in-chat-name{font-size:0.875rem;font-weight:600;color:var(--zak-text,#1a1a2e)}
.zak-ai-avatar-in-chat-status{font-size:0.75rem;color:var(--zak-text-muted,#64748b)}
.zak-ai-cmd-overlay{position:fixed;inset:0;background:rgba(0,0,0,0.5);backdrop-filter:blur(4px);-webkit-backdrop-filter:blur(4px);z-index:1000;display:flex;align-items:flex-start;justify-content:center;padding-top:15vh;opacity:0;pointer-events:none;transition:opacity 0.2s}
.zak-ai-cmd-overlay.show{opacity:1;pointer-events:auto}
.zak-ai-cmd-modal{width:100%;max-width:560px;background:var(--zak-bg,#fff);border:1px solid var(--zak-border-color,#e2e8f0);border-radius:0.875rem;box-shadow:0 24px 48px rgba(0,0,0,0.2);overflow:hidden;transform:scale(0.96) translateY(-8px);transition:transform 0.2s}
.zak-ai-cmd-overlay.show .zak-ai-cmd-modal{transform:scale(1) translateY(0)}
.zak-ai-cmd-search{display:flex;align-items:center;gap:0.625rem;padding:0.875rem 1rem;border-bottom:1px solid var(--zak-border-color,#e2e8f0)}
.zak-ai-cmd-search svg{width:1.125rem;height:1.125rem;color:var(--zak-text-muted,#64748b);flex-shrink:0}
.zak-ai-cmd-search input{flex:1;border:none;outline:none;font-size:0.9375rem;background:transparent;color:var(--zak-text,#1a1a2e)}
.zak-ai-cmd-search input::placeholder{color:var(--zak-text-muted,#94a3b8)}
.zak-ai-cmd-search kbd{background:var(--zak-bg-secondary,#f1f5f9);border:1px solid var(--zak-border-color,#e2e8f0);border-radius:0.25rem;padding:0.125rem 0.375rem;font-size:0.6875rem;color:var(--zak-text-muted,#64748b)}
.zak-ai-cmd-list{max-height:360px;overflow-y:auto;padding:0.375rem}
.zak-ai-cmd-category{font-size:0.6875rem;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;color:var(--zak-text-muted,#94a3b8);padding:0.625rem 0.75rem 0.25rem}
.zak-ai-cmd-item{display:flex;align-items:center;gap:0.625rem;padding:0.5rem 0.75rem;border-radius:0.5rem;cursor:pointer;transition:background 0.1s}
.zak-ai-cmd-item:hover,.zak-ai-cmd-item.active{background:rgba(99,102,241,0.08)}
.zak-ai-cmd-item-icon{width:1.75rem;height:1.75rem;border-radius:0.375rem;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:0.875rem}
.zak-ai-cmd-item-icon.ai{background:rgba(99,102,241,0.1);color:#6366f1}
.zak-ai-cmd-item-icon.action{background:rgba(16,185,129,0.1);color:#10b981}
.zak-ai-cmd-item-icon.nav{background:rgba(245,158,11,0.1);color:#f59e0b}
.zak-ai-cmd-item-icon svg{width:1rem;height:1rem}
.zak-ai-cmd-item-text{flex:1;font-size:0.875rem;color:var(--zak-text,#1a1a2e);font-weight:500}
.zak-ai-cmd-item-desc{font-size:0.75rem;color:var(--zak-text-muted,#64748b);font-weight:400;margin-left:0.25rem}
.zak-ai-cmd-item-shortcut{display:flex;gap:0.25rem}
.zak-ai-cmd-item-shortcut kbd{background:var(--zak-bg-secondary,#f1f5f9);border:1px solid var(--zak-border-color,#e2e8f0);border-radius:0.25rem;padding:0.125rem 0.375rem;font-size:0.6875rem;color:var(--zak-text-muted,#64748b);min-width:1.25rem;text-align:center}
.zak-ai-cmd-footer{padding:0.5rem 0.875rem;border-top:1px solid var(--zak-border-color,#e2e8f0);display:flex;gap:1rem;font-size:0.6875rem;color:var(--zak-text-muted,#94a3b8)}
.zak-ai-cmd-footer span{display:flex;align-items:center;gap:0.25rem}
.zak-ai-cmd-footer kbd{background:var(--zak-bg-secondary,#f1f5f9);border:1px solid var(--zak-border-color,#e2e8f0);border-radius:0.25rem;padding:0.0625rem 0.3125rem;font-size:0.625rem}
.zak-ai-cmd-recent{display:flex;align-items:center;gap:0.375rem;padding:0.375rem 0.75rem;font-size:0.75rem;color:var(--zak-text-muted,#64748b)}
.zak-ai-cmd-recent svg{width:0.75rem;height:0.75rem}
.zak-ai-input-wrap{position:relative;display:flex;align-items:center;gap:0.5rem}
.zak-ai-input{width:100%;padding:0.625rem 0.875rem 0.625rem 2.75rem;border:1.5px solid var(--zak-border-color,#e2e8f0);border-radius:0.75rem;font-size:0.9375rem;background:var(--zak-bg,#fff);color:var(--zak-text,#1a1a2e);transition:border-color 0.2s,box-shadow 0.2s;outline:none}
.zak-ai-input:focus{border-color:#6366f1;box-shadow:0 0 0 3px rgba(99,102,241,0.15)}
.zak-ai-input-icon{position:absolute;left:0.75rem;top:50%;transform:translateY(-50%);color:#6366f1;pointer-events:none}
.zak-ai-input-send{position:absolute;right:0.375rem;top:50%;transform:translateY(-50%);background:linear-gradient(135deg,#6366f1,#8b5cf6);border:none;color:#fff;width:2rem;height:2rem;border-radius:0.5rem;display:flex;align-items:center;justify-content:center;cursor:pointer;transition:opacity 0.2s}
.zak-ai-input-send:hover{opacity:0.85}
.zak-ai-input-send svg{width:1rem;height:1rem}
.zak-ai-input-model{padding:0.5rem 0.75rem;border:1.5px solid var(--zak-border-color,#e2e8f0);border-radius:0.75rem;font-size:0.8125rem;background:var(--zak-bg,#fff);color:var(--zak-text,#1a1a2e);cursor:pointer;outline:none;white-space:nowrap}
.zak-ai-suggestions{position:absolute;top:calc(100% + 0.375rem);left:0;right:0;background:var(--zak-bg,#fff);border:1px solid var(--zak-border-color,#e2e8f0);border-radius:0.75rem;box-shadow:0 8px 24px rgba(0,0,0,0.1);padding:0.375rem;z-index:10;display:none}
.zak-ai-suggestions.show{display:block}
.zak-ai-suggestion-item{padding:0.5rem 0.75rem;border-radius:0.5rem;cursor:pointer;font-size:0.875rem;display:flex;align-items:center;gap:0.5rem;transition:background 0.15s}
.zak-ai-suggestion-item:hover{background:rgba(99,102,241,0.08)}
.zak-ai-suggestion-item svg{width:1rem;height:1rem;color:#6366f1;flex-shrink:0}
.zak-ai-char-count{font-size:0.75rem;color:var(--zak-text-muted,#94a3b8);text-align:right;margin-top:0.375rem}
.zak-ai-input-with-actions{display:flex;gap:0.5rem;align-items:center}
.zak-ai-input-ask-btn{padding:0.625rem 1rem;background:linear-gradient(135deg,#6366f1,#8b5cf6);border:none;color:#fff;border-radius:0.75rem;font-size:0.875rem;font-weight:600;cursor:pointer;white-space:nowrap;transition:all 0.2s}
.zak-ai-input-ask-btn:hover{box-shadow:0 4px 12px rgba(99,102,241,0.4);transform:translateY(-1px)}
.zak-ai-prompt{position:relative;display:flex;flex-direction:column;border:1.5px solid var(--zak-border-color,#e2e8f0);border-radius:0.875rem;background:var(--zak-bg,#fff);transition:border-color 0.2s,box-shadow 0.2s;overflow:hidden}
.zak-ai-prompt:focus-within{border-color:#6366f1;box-shadow:0 0 0 3px rgba(99,102,241,0.12)}
.zak-ai-prompt-toolbar{display:flex;align-items:center;gap:0.375rem;padding:0.5rem 0.75rem;border-bottom:1px solid var(--zak-border-color,#e2e8f0);background:var(--zak-bg-secondary,#f8fafc)}
.zak-ai-prompt-toolbar button{background:none;border:none;cursor:pointer;padding:0.375rem;border-radius:0.375rem;color:var(--zak-text-muted,#64748b);transition:background 0.15s,color 0.15s}
.zak-ai-prompt-toolbar button:hover{background:rgba(99,102,241,0.1);color:#6366f1}
.zak-ai-prompt-toolbar button svg{width:1.125rem;height:1.125rem}
.zak-ai-prompt textarea{border:none;outline:none;resize:none;padding:0.75rem;font-size:0.9375rem;line-height:1.6;min-height:80px;max-height:300px;font-family:inherit;color:var(--zak-text,#1a1a2e);background:transparent}
.zak-ai-prompt textarea::placeholder{color:var(--zak-text-muted,#94a3b8)}
.zak-ai-prompt-footer{display:flex;align-items:center;justify-content:space-between;padding:0.5rem 0.75rem;border-top:1px solid var(--zak-border-color,#e2e8f0);background:var(--zak-bg-secondary,#f8fafc)}
.zak-ai-prompt-footer-left{display:flex;align-items:center;gap:0.5rem}
.zak-ai-prompt-footer-right{display:flex;align-items:center;gap:0.5rem}
.zak-ai-prompt-hint{font-size:0.75rem;color:var(--zak-text-muted,#94a3b8)}
.zak-ai-prompt-hint kbd{background:var(--zak-bg,#fff);border:1px solid var(--zak-border-color,#e2e8f0);border-radius:0.25rem;padding:0.0625rem 0.375rem;font-size:0.6875rem;font-family:inherit}
.zak-ai-prompt-count{font-size:0.75rem;color:var(--zak-text-muted,#94a3b8)}
.zak-prompt-token-count { font-weight: var(--zak-font-weight-semibold); color: var(--zak-text); }
.zak-ai-prompt-enhance{background:linear-gradient(135deg,#6366f1,#8b5cf6);border:none;color:#fff;padding:0.375rem 0.75rem;border-radius:0.5rem;font-size:0.8125rem;font-weight:600;cursor:pointer;display:flex;align-items:center;gap:0.375rem;transition:all 0.2s}
.zak-ai-prompt-enhance:hover{box-shadow:0 2px 8px rgba(99,102,241,0.35);transform:translateY(-1px)}
.zak-ai-prompt-enhance svg{width:0.875rem;height:0.875rem}
.zak-ai-prompt-send{background:linear-gradient(135deg,#6366f1,#8b5cf6);border:none;color:#fff;width:2rem;height:2rem;border-radius:0.5rem;display:flex;align-items:center;justify-content:center;cursor:pointer;transition:all 0.2s}
.zak-ai-prompt-send:hover{box-shadow:0 2px 8px rgba(99,102,241,0.35)}
.zak-ai-prompt-send svg{width:1rem;height:1rem}
.zak-ai-prompt-send:disabled{opacity:0.5;cursor:not-allowed;box-shadow:none;transform:none}
.zak-ai-prompt-model{padding:0.375rem 0.625rem;border:1px solid var(--zak-border-color,#e2e8f0);border-radius:0.5rem;font-size:0.75rem;background:var(--zak-bg,#fff);color:var(--zak-text,#1a1a2e);cursor:pointer;outline:none}
.zak-ai-response{position:relative;border:1.5px solid var(--zak-border-color,#e2e8f0);border-radius:0.875rem;padding:1.25rem;background:var(--zak-bg,#fff)}
.zak-ai-response-header{display:flex;align-items:center;gap:0.5rem;margin-bottom:0.75rem}
.zak-ai-response-avatar{width:1.75rem;height:1.75rem;border-radius:0.375rem;background:linear-gradient(135deg,#6366f1,#8b5cf6);display:flex;align-items:center;justify-content:center;color:#fff;flex-shrink:0}
.zak-ai-response-avatar svg{width:0.875rem;height:0.875rem}
.zak-ai-response-model{font-size:0.8125rem;font-weight:600;color:var(--zak-text,#1a1a2e)}
.zak-ai-response h1,.zak-ai-response h2,.zak-ai-response h3{color:var(--zak-text,#1a1a2e);margin:1rem 0 0.5rem;line-height:1.4}
.zak-ai-response h1{font-size:1.25rem}
.zak-ai-response h2{font-size:1.0625rem}
.zak-ai-response h3{font-size:0.9375rem}
.zak-ai-response p{margin:0 0 0.75rem;color:var(--zak-text,#1a1a2e);line-height:1.7;font-size:0.9375rem}
.zak-ai-response strong{font-weight:600}
.zak-ai-response code{background:rgba(99,102,241,0.08);color:#6366f1;padding:0.125rem 0.375rem;border-radius:0.25rem;font-size:0.8125rem;font-family:'SF Mono',Menlo,monospace}
.zak-ai-response pre{background:#1e1e2e;color:#cdd6f4;padding:1rem;border-radius:0.5rem;overflow-x:auto;margin:0.75rem 0;font-size:0.8125rem;line-height:1.6}
.zak-ai-response pre code{background:none;color:inherit;padding:0}
.zak-ai-response ul,.zak-ai-response ol{margin:0.5rem 0;padding-left:1.5rem}
.zak-ai-response li{margin-bottom:0.375rem;line-height:1.6;color:var(--zak-text,#1a1a2e);font-size:0.9375rem}
.zak-ai-response blockquote{border-left:3px solid #6366f1;padding:0.5rem 1rem;margin:0.75rem 0;background:rgba(99,102,241,0.04);border-radius:0 0.5rem 0.5rem 0;color:var(--zak-text-muted,#64748b)}
.zak-ai-response-footer{display:flex;align-items:center;justify-content:space-between;margin-top:1rem;padding-top:0.75rem;border-top:1px solid var(--zak-border-color,#e2e8f0)}
.zak-ai-response-actions{display:flex;gap:0.25rem}
.zak-ai-response-actions button{background:none;border:none;cursor:pointer;padding:0.375rem;border-radius:0.375rem;color:var(--zak-text-muted,#64748b);transition:background 0.15s,color 0.15s;display:flex;align-items:center;gap:0.25rem;font-size:0.75rem}
.zak-ai-response-actions button:hover{background:rgba(99,102,241,0.1);color:#6366f1}
.zak-ai-response-actions button svg{width:0.875rem;height:0.875rem}
.zak-ai-response-tokens{font-size:0.75rem;color:var(--zak-text-muted,#94a3b8);display:flex;align-items:center;gap:0.25rem}
.zak-ai-response-tokens svg{width:0.75rem;height:0.75rem}
.zak-ai-response-feedback{display:flex;gap:0.25rem}
.zak-ai-response-feedback button{background:none;border:1px solid var(--zak-border-color,#e2e8f0);cursor:pointer;padding:0.25rem 0.5rem;border-radius:0.375rem;color:var(--zak-text-muted,#64748b);transition:all 0.15s;display:flex;align-items:center}
.zak-ai-response-feedback button:hover{border-color:#6366f1;color:#6366f1}
.zak-ai-response-feedback button.active{background:rgba(99,102,241,0.1);border-color:#6366f1;color:#6366f1}
.zak-ai-response-feedback button svg{width:0.875rem;height:0.875rem}
.zak-ai-response-sources{margin-top:0.75rem;padding:0.75rem;background:var(--zak-bg-secondary,#f8fafc);border-radius:0.5rem;border:1px solid var(--zak-border-color,#e2e8f0)}
.zak-ai-response-sources-title{font-size:0.75rem;font-weight:600;color:var(--zak-text-muted,#64748b);text-transform:uppercase;letter-spacing:0.05em;margin-bottom:0.5rem}
.zak-ai-response-source{display:flex;align-items:center;gap:0.5rem;padding:0.375rem 0;font-size:0.8125rem}
.zak-ai-response-source-num{width:1.25rem;height:1.25rem;border-radius:50%;background:rgba(99,102,241,0.1);color:#6366f1;display:flex;align-items:center;justify-content:center;font-size:0.6875rem;font-weight:700;flex-shrink:0}
.zak-ai-response-source a{color:#6366f1;text-decoration:none}
.zak-ai-response-source a:hover{text-decoration:underline}
.zak-ai-response-source span{color:var(--zak-text-muted,#64748b);font-size:0.75rem}
.zak-ai-chat{display:flex;height:520px;border:1.5px solid var(--zak-border-color,#e2e8f0);border-radius:0.875rem;overflow:hidden;background:var(--zak-bg,#fff)}
.zak-ai-chat-sidebar{width:240px;border-right:1px solid var(--zak-border-color,#e2e8f0);display:flex;flex-direction:column;background:var(--zak-bg-secondary,#f8fafc)}
.zak-ai-chat-sidebar-header{padding:0.75rem;border-bottom:1px solid var(--zak-border-color,#e2e8f0);display:flex;align-items:center;justify-content:space-between}
.zak-ai-chat-sidebar-title{font-size:0.8125rem;font-weight:600;color:var(--zak-text,#1a1a2e)}
.zak-ai-chat-sidebar-list{flex:1;overflow-y:auto;padding:0.375rem}
.zak-ai-chat-sidebar-item{padding:0.625rem 0.75rem;border-radius:0.5rem;cursor:pointer;font-size:0.8125rem;color:var(--zak-text-muted,#64748b);transition:background 0.15s;margin-bottom:0.125rem}
.zak-ai-chat-sidebar-item:hover{background:rgba(99,102,241,0.06);color:var(--zak-text,#1a1a2e)}
.zak-ai-chat-sidebar-item.active{background:rgba(99,102,241,0.1);color:#6366f1;font-weight:500}
.zak-ai-chat-sidebar-new{display:flex;align-items:center;gap:0.375rem;padding:0.5rem 0.75rem;margin:0.375rem;border:none;background:none;color:#6366f1;font-size:0.8125rem;font-weight:600;cursor:pointer;border-radius:0.5rem;width:calc(100% - 0.75rem);transition:background 0.15s}
.zak-ai-chat-sidebar-new:hover{background:rgba(99,102,241,0.08)}
.zak-ai-chat-main{flex:1;display:flex;flex-direction:column}
.zak-ai-chat-header{padding:0.75rem 1rem;border-bottom:1px solid var(--zak-border-color,#e2e8f0);display:flex;align-items:center;gap:0.625rem}
.zak-ai-chat-avatar{width:2rem;height:2rem;border-radius:0.5rem;background:linear-gradient(135deg,#6366f1,#8b5cf6);display:flex;align-items:center;justify-content:center;color:#fff;flex-shrink:0}
.zak-ai-chat-avatar svg{width:1rem;height:1rem}
.zak-ai-chat-header-info h3{font-size:0.875rem;font-weight:600;color:var(--zak-text,#1a1a2e);margin:0}
.zak-ai-chat-header-info span{font-size:0.75rem;color:var(--zak-text-muted,#64748b)}
.zak-ai-chat-messages{flex:1;overflow-y:auto;padding:1rem;display:flex;flex-direction:column;gap:1rem}
.zak-ai-chat-msg{display:flex;gap:0.625rem;max-width:85%}
.zak-ai-chat-msg.user{align-self:flex-end;flex-direction:row-reverse}
.zak-ai-chat-msg-avatar{width:1.75rem;height:1.75rem;border-radius:0.375rem;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:0.6875rem;font-weight:700;color:#fff}
.zak-ai-chat-msg.ai .zak-ai-chat-msg-avatar{background:linear-gradient(135deg,#6366f1,#8b5cf6)}
.zak-ai-chat-msg.user .zak-ai-chat-msg-avatar{background:#0ea5e9}
.zak-ai-chat-msg-bubble{padding:0.625rem 0.875rem;border-radius:0.75rem;font-size:0.875rem;line-height:1.6}
.zak-ai-chat-msg.ai .zak-ai-chat-msg-bubble{background:var(--zak-bg-secondary,#f1f5f9);color:var(--zak-text,#1a1a2e);border-bottom-left-radius:0.25rem}
.zak-ai-chat-msg.user .zak-ai-chat-msg-bubble{background:linear-gradient(135deg,#6366f1,#8b5cf6);color:#fff;border-bottom-right-radius:0.25rem}
.zak-ai-chat-input-area{padding:0.75rem 1rem;border-top:1px solid var(--zak-border-color,#e2e8f0);display:flex;gap:0.5rem;align-items:flex-end}
.zak-ai-chat-input-area textarea{flex:1;border:1.5px solid var(--zak-border-color,#e2e8f0);border-radius:0.75rem;padding:0.625rem 0.875rem;font-size:0.875rem;resize:none;outline:none;min-height:2.5rem;max-height:8rem;font-family:inherit;color:var(--zak-text,#1a1a2e);background:var(--zak-bg,#fff)}
.zak-ai-chat-input-area textarea:focus{border-color:#6366f1}
.zak-ai-chat-input-send{background:linear-gradient(135deg,#6366f1,#8b5cf6);border:none;color:#fff;width:2.5rem;height:2.5rem;border-radius:0.625rem;display:flex;align-items:center;justify-content:center;cursor:pointer;flex-shrink:0;transition:all 0.2s}
.zak-ai-chat-input-send:hover{box-shadow:0 2px 8px rgba(99,102,241,0.35)}
.zak-ai-chat-input-send svg{width:1.125rem;height:1.125rem}
.zak-ai-chat-typing{display:flex;gap:0.25rem;padding:0.5rem 0.875rem;align-items:center}
.zak-ai-chat-typing-dot{width:0.375rem;height:0.375rem;border-radius:50%;background:#6366f1;animation:chat-bounce 1.4s ease-in-out infinite}
.zak-ai-chat-typing-dot:nth-child(2){animation-delay:0.2s}
.zak-ai-chat-typing-dot:nth-child(3){animation-delay:0.4s}
@keyframes chat-bounce {
  0%,60%,100%{transform:translateY(0)}
  30%{transform:translateY(-4px)}
}
.zak-ai-cmsg{display:flex;gap:0.625rem;max-width:640px;margin-bottom:1rem}
.zak-ai-cmsg.user{flex-direction:row-reverse;margin-left:auto}
.zak-ai-cmsg-avatar{width:2rem;height:2rem;border-radius:0.5rem;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:0.6875rem;font-weight:700;color:#fff}
.zak-ai-cmsg.ai .zak-ai-cmsg-avatar{background:linear-gradient(135deg,#6366f1,#8b5cf6)}
.zak-ai-cmsg.user .zak-ai-cmsg-avatar{background:#0ea5e9}
.zak-ai-cmsg-body{flex:1}
.zak-ai-cmsg-meta{display:flex;align-items:center;gap:0.5rem;margin-bottom:0.25rem;font-size:0.75rem;color:var(--zak-text-muted,#64748b)}
.zak-ai-cmsg.user .zak-ai-cmsg-meta{flex-direction:row-reverse}
.zak-ai-cmsg-name{font-weight:600;color:var(--zak-text,#1a1a2e)}
.zak-ai-cmsg-bubble{padding:0.75rem 1rem;border-radius:0.75rem;font-size:0.875rem;line-height:1.7}
.zak-ai-cmsg.ai .zak-ai-cmsg-bubble{background:var(--zak-bg-secondary,#f1f5f9);color:var(--zak-text,#1a1a2e);border-top-left-radius:0.25rem}
.zak-ai-cmsg.user .zak-ai-cmsg-bubble{background:linear-gradient(135deg,#6366f1,#8b5cf6);color:#fff;border-top-right-radius:0.25rem}
.zak-ai-cmsg-bubble strong{font-weight:600}
.zak-ai-cmsg-bubble code{background:rgba(0,0,0,0.06);padding:0.125rem 0.375rem;border-radius:0.25rem;font-size:0.8125rem;font-family:'SF Mono',Menlo,monospace}
.zak-ai-cmsg.user .zak-ai-cmsg-bubble code{background:rgba(255,255,255,0.2)}
.zak-ai-cmsg-bubble pre{background:rgba(0,0,0,0.05);padding:0.75rem;border-radius:0.5rem;overflow-x:auto;margin:0.5rem 0;font-size:0.8125rem;line-height:1.5}
.zak-ai-cmsg-bubble ul,.zak-ai-cmsg-bubble ol{margin:0.5rem 0;padding-left:1.25rem}
.zak-ai-cmsg-bubble li{margin-bottom:0.25rem}
.zak-ai-cmsg-bubble a{color:#6366f1;text-decoration:underline}
.zak-ai-cmsg.user .zak-ai-cmsg-bubble a{color:#e0e7ff}
.zak-ai-cmsg-actions{display:flex;gap:0.25rem;margin-top:0.375rem;opacity:0;transition:opacity 0.2s}
.zak-ai-cmsg:hover .zak-ai-cmsg-actions{opacity:1}
.zak-ai-cmsg-actions button{background:none;border:none;cursor:pointer;padding:0.25rem;border-radius:0.25rem;color:var(--zak-text-muted,#64748b);transition:background 0.15s,color 0.15s}
.zak-ai-cmsg-actions button:hover{background:rgba(99,102,241,0.1);color:#6366f1}
.zak-ai-cmsg-actions button svg{width:0.875rem;height:0.875rem}
.zak-ai-cite{color:#6366f1;font-weight:600;font-size:0.75em;vertical-align:super;cursor:pointer;text-decoration:none;transition:color 0.15s}
.zak-ai-cite:hover{color:#4f46e5;text-decoration:underline}
.zak-ai-cite-block{display:flex;gap:0.75rem;padding:0.875rem;border:1.5px solid var(--zak-border-color,#e2e8f0);border-radius:0.75rem;background:var(--zak-bg,#fff);transition:border-color 0.2s}
.zak-ai-cite-block:hover{border-color:rgba(99,102,241,0.3)}
.zak-ai-cite-block-num{width:1.5rem;height:1.5rem;border-radius:50%;background:rgba(99,102,241,0.1);color:#6366f1;display:flex;align-items:center;justify-content:center;font-size:0.6875rem;font-weight:700;flex-shrink:0;margin-top:0.125rem}
.zak-ai-cite-block-body{flex:1;min-width:0}
.zak-ai-cite-block-title{font-size:0.875rem;font-weight:600;color:var(--zak-text,#1a1a2e);margin-bottom:0.25rem;display:flex;align-items:center;gap:0.375rem}
.zak-ai-cite-block-title a{color:inherit;text-decoration:none}
.zak-ai-cite-block-title a:hover{color:#6366f1;text-decoration:underline}
.zak-ai-cite-block-url{font-size:0.75rem;color:var(--zak-text-muted,#64748b);margin-bottom:0.375rem}
.zak-ai-cite-block-snippet{font-size:0.8125rem;color:var(--zak-text-muted,#64748b);line-height:1.5}
.zak-ai-cite-block-snippet mark{background:rgba(99,102,241,0.12);color:var(--zak-text,#1a1a2e);padding:0.0625rem 0.25rem;border-radius:0.125rem}
.zak-ai-cite-list{display:flex;flex-direction:column;gap:0.5rem}
.zak-ai-cite-preview{position:relative}
.zak-ai-cite-preview .zak-ai-cite-preview-popup{display:none;position:absolute;bottom:calc(100% + 0.5rem);left:0;width:300px;padding:0.75rem;background:var(--zak-bg,#fff);border:1px solid var(--zak-border-color,#e2e8f0);border-radius:0.75rem;box-shadow:0 8px 24px rgba(0,0,0,0.12);z-index:10;font-size:0.8125rem}
.zak-ai-cite-preview:hover .zak-ai-cite-preview-popup{display:block}
.zak-ai-cite-preview-title{font-weight:600;color:var(--zak-text,#1a1a2e);margin-bottom:0.25rem}
.zak-ai-cite-preview-url{font-size:0.6875rem;color:#6366f1;margin-bottom:0.375rem}
.zak-ai-cite-preview-snippet{color:var(--zak-text-muted,#64748b);line-height:1.5}
.zak-ai-cite-highlight{padding:1rem 1.25rem;border-left:3px solid #6366f1;background:rgba(99,102,241,0.04);border-radius:0 0.5rem 0.5rem 0;font-size:0.9375rem;line-height:1.7;color:var(--zak-text,#1a1a2e)}
.zak-ai-cite-inline{display:inline-flex;align-items:center;gap:0.375rem;padding:0.125rem 0.5rem;background:rgba(99,102,241,0.06);border-radius:0.375rem;font-size:0.8125rem;color:#6366f1;text-decoration:none;border:1px solid rgba(99,102,241,0.15);transition:all 0.15s}
.zak-ai-cite-inline:hover{background:rgba(99,102,241,0.12);border-color:rgba(99,102,241,0.3)}
.zak-ai-cite-inline svg{width:0.75rem;height:0.75rem}
.zak-ai-convos{width:300px;border:1.5px solid var(--zak-border-color,#e2e8f0);border-radius:0.875rem;overflow:hidden;background:var(--zak-bg,#fff);display:flex;flex-direction:column}
.zak-ai-convos-header{padding:0.75rem;border-bottom:1px solid var(--zak-border-color,#e2e8f0);display:flex;align-items:center;justify-content:space-between}
.zak-ai-convos-header h3{font-size:0.875rem;font-weight:600;margin:0;color:var(--zak-text,#1a1a2e)}
.zak-ai-convos-new{background:linear-gradient(135deg,#6366f1,#8b5cf6);border:none;color:#fff;padding:0.4375rem 0.75rem;border-radius:0.5rem;font-size:0.8125rem;font-weight:600;cursor:pointer;display:flex;align-items:center;gap:0.375rem;transition:all 0.2s}
.zak-ai-convos-new:hover{box-shadow:0 2px 8px rgba(99,102,241,0.35)}
.zak-ai-convos-new svg{width:0.875rem;height:0.875rem}
.zak-ai-convos-list{flex:1;overflow-y:auto;padding:0.375rem}
.zak-ai-convos-group-label{font-size:0.6875rem;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;color:var(--zak-text-muted,#94a3b8);padding:0.625rem 0.75rem 0.25rem}
.zak-ai-convo-item{display:flex;align-items:center;gap:0.625rem;padding:0.625rem 0.75rem;border-radius:0.5rem;cursor:pointer;transition:background 0.15s;margin-bottom:0.125rem;position:relative}
.zak-ai-convo-item:hover{background:rgba(99,102,241,0.06)}
.zak-ai-convo-item.active{background:rgba(99,102,241,0.1)}
.zak-ai-convo-icon{width:1.75rem;height:1.75rem;border-radius:0.375rem;background:var(--zak-bg-secondary,#f1f5f9);display:flex;align-items:center;justify-content:center;flex-shrink:0;color:var(--zak-text-muted,#64748b)}
.zak-ai-convo-icon svg{width:0.875rem;height:0.875rem}
.zak-ai-convo-item.active .zak-ai-convo-icon{background:rgba(99,102,241,0.15);color:#6366f1}
.zak-ai-convo-info{flex:1;min-width:0}
.zak-ai-convo-title{font-size:0.8125rem;font-weight:500;color:var(--zak-text,#1a1a2e);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.zak-ai-convo-preview{font-size:0.75rem;color:var(--zak-text-muted,#64748b);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.zak-ai-convo-time{font-size:0.6875rem;color:var(--zak-text-muted,#94a3b8);flex-shrink:0}
.zak-ai-convo-badge{position:absolute;top:0.5rem;right:0.5rem;width:0.5rem;height:0.5rem;border-radius:50%;background:#6366f1}
.zak-ai-convos-compact{width:100%;max-width:320px}
.zak-ai-convos-compact .zak-ai-convo-item{padding:0.5rem 0.625rem}
.zak-ai-convos-inline{display:flex;gap:0.5rem;overflow-x:auto;padding-bottom:0.5rem}
.zak-ai-convos-inline .zak-ai-convo-item{min-width:180px;border:1px solid var(--zak-border-color,#e2e8f0);border-radius:0.75rem;padding:0.625rem;flex-shrink:0;background:var(--zak-bg,#fff)}
.zak-ai-suggestions-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:0.75rem}
.zak-ai-suggestion-card{padding:1rem;border:1.5px solid var(--zak-border-color,#e2e8f0);border-radius:0.75rem;cursor:pointer;transition:all 0.2s;background:var(--zak-bg,#fff)}
.zak-ai-suggestion-card:hover{border-color:#6366f1;box-shadow:0 4px 16px rgba(99,102,241,0.12);transform:translateY(-2px)}
.zak-ai-suggestion-card-header{display:flex;align-items:center;gap:0.5rem;margin-bottom:0.5rem}
.zak-ai-suggestion-card-icon{width:2rem;height:2rem;border-radius:0.5rem;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.zak-ai-suggestion-card-icon svg{width:1.125rem;height:1.125rem}
.zak-ai-suggestion-card-title{font-weight:600;font-size:0.875rem;color:var(--zak-text,#1a1a2e)}
.zak-ai-suggestion-card-desc{font-size:0.8125rem;color:var(--zak-text-muted,#64748b);line-height:1.5;margin-bottom:0.75rem}
.zak-ai-suggestion-card-action{display:inline-flex;align-items:center;gap:0.375rem;font-size:0.75rem;font-weight:600;color:#6366f1;transition:gap 0.2s}
.zak-ai-suggestion-card:hover .zak-ai-suggestion-card-action{gap:0.625rem}
.zak-ai-suggestion-card-action svg{width:0.875rem;height:0.875rem}
.zak-ai-chips{display:flex;flex-wrap:wrap;gap:0.5rem}
.zak-ai-chip{display:inline-flex;align-items:center;gap:0.375rem;padding:0.4375rem 0.875rem;border:1.5px solid var(--zak-border-color,#e2e8f0);border-radius:2rem;font-size:0.8125rem;font-weight:500;color:var(--zak-text,#1a1a2e);cursor:pointer;transition:all 0.2s;background:var(--zak-bg,#fff)}
.zak-ai-chip:hover{border-color:#6366f1;background:rgba(99,102,241,0.04);color:#6366f1}
.zak-ai-chip svg{width:0.875rem;height:0.875rem}
.zak-ai-suggestion-categories{display:flex;flex-wrap:wrap;gap:0.5rem;margin-bottom:1rem}
.zak-ai-suggestion-cat{padding:0.4375rem 0.875rem;border-radius:2rem;font-size:0.8125rem;font-weight:600;cursor:pointer;transition:all 0.2s;border:none}
.zak-ai-suggestion-cat.active{background:linear-gradient(135deg,#6366f1,#8b5cf6);color:#fff}
.zak-ai-suggestion-cat:not(.active){background:var(--zak-bg-secondary,#f1f5f9);color:var(--zak-text-muted,#64748b)}
.zak-ai-suggestion-cat:not(.active):hover{background:rgba(99,102,241,0.1);color:#6366f1}
.zak-ai-suggestion-carousel{display:flex;gap:0.75rem;overflow-x:auto;padding-bottom:0.5rem;scroll-snap-type:x mandatory}
.zak-ai-suggestion-carousel::-webkit-scrollbar{height:4px}
.zak-ai-suggestion-carousel::-webkit-scrollbar-thumb{background:#cbd5e1;border-radius:2px}
.zak-ai-suggestion-carousel .zak-ai-suggestion-card{min-width:260px;scroll-snap-align:start;flex-shrink:0}
.zak-ai-stream{position:relative;padding:1rem 1.25rem;background:var(--zak-bg-secondary,#f1f5f9);border-radius:0.75rem;font-size:0.9375rem;line-height:1.7;color:var(--zak-text,#1a1a2e)}
.zak-ai-stream::after{content:'';display:inline-block;width:2px;height:1.1em;background:#6366f1;margin-left:2px;vertical-align:text-bottom;animation:stream-blink 0.8s step-end infinite}
@keyframes stream-blink {
  0%,100%{opacity:1}
  50%{opacity:0}
}
.zak-ai-stream-cursor{display:inline-block;width:2px;height:1em;background:#6366f1;margin-left:1px;vertical-align:text-bottom;animation:stream-blink 0.8s step-end infinite}
.zak-ai-stream-progress{display:flex;align-items:center;gap:0.5rem;margin-top:0.5rem;font-size:0.75rem;color:var(--zak-text-muted,#64748b)}
.zak-ai-stream-progress-bar{flex:1;height:3px;background:var(--zak-border-color,#e2e8f0);border-radius:2px;overflow:hidden;max-width:200px}
.zak-ai-stream-progress-fill{height:100%;background:linear-gradient(90deg,#6366f1,#8b5cf6);border-radius:2px;animation:stream-progress 3s ease-in-out infinite}
@keyframes stream-progress {
  0%{width:10%}
  50%{width:70%}
  100%{width:100%}
}
.zak-ai-stream-dots{display:flex;gap:0.375rem;align-items:center}
.zak-ai-stream-dot{width:6px;height:6px;border-radius:50%;background:#6366f1;animation:stream-pulse 1.4s ease-in-out infinite}
.zak-ai-stream-dot:nth-child(2){animation-delay:0.2s}
.zak-ai-stream-dot:nth-child(3){animation-delay:0.4s}
@keyframes stream-pulse {
  0%,60%,100%{opacity:0.3;transform:scale(0.8)}
  30%{opacity:1;transform:scale(1)}
}
.zak-ai-stream-complete{position:relative;padding:1rem 1.25rem;background:var(--zak-bg-secondary,#f1f5f9);border-radius:0.75rem;font-size:0.9375rem;line-height:1.7;color:var(--zak-text,#1a1a2e)}
.zak-ai-stream-complete::after{content:'✓';position:absolute;top:0.5rem;right:0.5rem;width:1.25rem;height:1.25rem;border-radius:50%;background:rgba(16,185,129,0.1);color:#10b981;display:flex;align-items:center;justify-content:center;font-size:0.6875rem;font-weight:700}
.zak-ai-stream-code{position:relative;padding:1rem;background:#1e1e2e;color:#cdd6f4;border-radius:0.75rem;font-size:0.8125rem;line-height:1.6;overflow:hidden}
.zak-ai-stream-code .zak-ai-stream-cursor{background:#cdd6f4}
.zak-ai-stream-code .stream-comment{color:#6c7086}
.zak-ai-stream-code .stream-keyword{color:#cba6f7}
.zak-ai-stream-code .stream-string{color:#a6e3a1}
.zak-ai-stream-code .stream-func{color:#89b4fa}
.zak-ai-stream-line-anim{animation:stream-line-reveal 0.5s ease-out both}
@keyframes stream-line-reveal {
  from{opacity:0;transform:translateY(4px)}
  to{opacity:1;transform:translateY(0)}
}
.zak-ai-stream-chars{display:inline}
.zak-ai-stream-chars span{animation:stream-char-appear 0.05s ease-out both}
@keyframes stream-char-appear {
  from { opacity: 0; }
  to { opacity: 1; }
}
.zak-ai-thinking{display:flex;align-items:center;gap:0.75rem;padding:0.75rem 1rem;background:var(--zak-bg-secondary,#f1f5f9);border-radius:0.75rem;font-size:0.875rem;color:var(--zak-text-muted,#64748b)}
.zak-ai-thinking-dots{display:flex;gap:0.3rem;align-items:center}
.zak-ai-thinking-dot{width:6px;height:6px;border-radius:50%;background:#6366f1;animation:think-bounce 1.4s ease-in-out infinite}
.zak-ai-thinking-dot:nth-child(2){animation-delay:0.16s}
.zak-ai-thinking-dot:nth-child(3){animation-delay:0.32s}
@keyframes think-bounce {
  0%,60%,100%{transform:translateY(0);opacity:0.4}
  30%{transform:translateY(-6px);opacity:1}
}
.zak-ai-thinking-text{font-weight:500;color:var(--zak-text,#1a1a2e)}
.zak-ai-thinking-spinner{width:1rem;height:1rem;border:2px solid var(--zak-border-color,#e2e8f0);border-top-color:#6366f1;border-radius:50%;animation:think-spin 0.7s linear infinite;flex-shrink:0}
@keyframes think-spin {
  to{transform:rotate(360deg)}
}
.zak-ai-thinking-progress{display:flex;flex-direction:column;gap:0.375rem;flex:1;max-width:200px}
.zak-ai-thinking-progress-bar{height:3px;background:var(--zak-border-color,#e2e8f0);border-radius:2px;overflow:hidden}
.zak-ai-thinking-progress-fill{height:100%;background:linear-gradient(90deg,#6366f1,#8b5cf6);border-radius:2px;animation:think-progress 3s ease-in-out infinite}
@keyframes think-progress {
  0%{width:5%}
  50%{width:65%}
}
.zak-ai-thinking-steps{display:flex;flex-direction:column;gap:0.5rem;padding:0.75rem 1rem;background:var(--zak-bg-secondary,#f1f5f9);border-radius:0.75rem;min-width:280px}
.zak-ai-thinking-step{display:flex;align-items:center;gap:0.5rem;font-size:0.8125rem;color:var(--zak-text-muted,#64748b)}
.zak-ai-thinking-step.active{color:var(--zak-text,#1a1a2e);font-weight:500}
.zak-ai-thinking-step.done{color:#10b981}
.zak-ai-thinking-step-icon{width:1.25rem;height:1.25rem;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:0.6875rem}
.zak-ai-thinking-step.done .zak-ai-thinking-step-icon{background:rgba(16,185,129,0.1);color:#10b981}
.zak-ai-thinking-step.active .zak-ai-thinking-step-icon{background:rgba(99,102,241,0.1);color:#6366f1}
.zak-ai-thinking-step.pending .zak-ai-thinking-step-icon{background:var(--zak-bg,#fff);color:var(--zak-text-muted,#94a3b8);border:1px solid var(--zak-border-color,#e2e8f0)}
.zak-ai-thinking-time{font-size:0.75rem;color:var(--zak-text-muted,#94a3b8);margin-left:auto;font-variant-numeric:tabular-nums}
.zak-ai-thinking-elaborate{padding:1rem;background:var(--zak-bg-secondary,#f1f5f9);border-radius:0.75rem;border-left:3px solid #6366f1}
.zak-ai-thinking-elaborate-label{font-size:0.75rem;font-weight:600;color:#6366f1;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:0.375rem;display:flex;align-items:center;gap:0.5rem}
.zak-ai-thinking-elaborate-label .zak-ai-thinking-dots{gap:0.2rem}
.zak-ai-thinking-elaborate-text{font-size:0.8125rem;color:var(--zak-text-muted,#64748b);line-height:1.5}
.zak-ai-token{display:flex;align-items:center;gap:0.5rem;font-size:0.8125rem;color:var(--zak-text-muted,#64748b)}
.zak-ai-token svg{width:0.875rem;height:0.875rem;flex-shrink:0}
.zak-ai-token-value{font-weight:600;color:var(--zak-text,#1a1a2e);font-variant-numeric:tabular-nums}
.zak-ai-token-bar{display:flex;flex-direction:column;gap:0.375rem;width:100%}
.zak-ai-token-bar-header{display:flex;justify-content:space-between;font-size:0.75rem;color:var(--zak-text-muted,#64748b)}
.zak-ai-token-bar-track{height:6px;background:var(--zak-border-color,#e2e8f0);border-radius:3px;overflow:hidden}
.zak-ai-token-bar-fill{height:100%;border-radius:3px;transition:width 0.5s ease}
.zak-ai-token-bar-fill.normal{background:linear-gradient(90deg,#6366f1,#8b5cf6)}
.zak-ai-token-bar-fill.warning{background:linear-gradient(90deg,#f59e0b,#f97316)}
.zak-ai-token-bar-fill.danger{background:linear-gradient(90deg,#ef4444,#dc2626)}
.zak-ai-token-cost{display:flex;align-items:center;gap:0.375rem;font-size:0.8125rem;padding:0.5rem 0.75rem;background:var(--zak-bg-secondary,#f8fafc);border-radius:0.5rem;border:1px solid var(--zak-border-color,#e2e8f0)}
.zak-ai-token-cost-label{color:var(--zak-text-muted,#64748b)}
.zak-ai-token-cost-value{font-weight:600;color:var(--zak-text,#1a1a2e);margin-left:auto}
.zak-ai-token-warning{display:flex;align-items:center;gap:0.5rem;padding:0.5rem 0.75rem;border-radius:0.5rem;font-size:0.8125rem;border:1px solid}
.zak-ai-token-warning.near-limit{background:rgba(245,158,11,0.08);border-color:rgba(245,158,11,0.3);color:#b45309}
.zak-ai-token-warning.exceeded{background:rgba(239,68,68,0.08);border-color:rgba(239,68,68,0.3);color:#dc2626}
.zak-ai-token-warning svg{width:1rem;height:1rem;flex-shrink:0}
.zak-ai-token-compact{display:inline-flex;align-items:center;gap:0.25rem;font-size:0.75rem;color:var(--zak-text-muted,#94a3b8);font-variant-numeric:tabular-nums}
.zak-ai-token-compact svg{width:0.75rem;height:0.75rem}
.zak-ai-token-model{display:flex;align-items:center;gap:0.75rem;padding:0.75rem;border:1px solid var(--zak-border-color,#e2e8f0);border-radius:0.75rem;background:var(--zak-bg,#fff)}
.zak-ai-token-model-avatar{width:2rem;height:2rem;border-radius:0.5rem;background:linear-gradient(135deg,#6366f1,#8b5cf6);display:flex;align-items:center;justify-content:center;color:#fff;flex-shrink:0}
.zak-ai-token-model-avatar svg{width:1rem;height:1rem}
.zak-ai-token-model-info{flex:1}
.zak-ai-token-model-name{font-size:0.875rem;font-weight:600;color:var(--zak-text,#1a1a2e)}
.zak-ai-token-model-detail{font-size:0.75rem;color:var(--zak-text-muted,#64748b)}
.zak-ai-token-model-count{font-size:1.25rem;font-weight:700;color:#6366f1;text-align:right}
.zak-ai-token-model-count small{display:block;font-size:0.6875rem;font-weight:500;color:var(--zak-text-muted,#64748b)}
.chart-container { max-width: 400px; }
.bar-chart { display: flex; align-items: flex-end; gap: 0.5rem; height: 200px; padding-top: 0.5rem; }
.bar-chart .bar { flex: 1; border-radius: 4px 4px 0 0; transition: height 0.3s ease; position: relative; min-width: 30px; }
.bar-chart .bar-label { position: absolute; top: -1.25rem; left: 50%; transform: translateX(-50%); font-size: 0.6875rem; color: var(--zak-text-muted); white-space: nowrap; }
.bar-chart .bar-x-label { text-align: center; font-size: 0.6875rem; color: var(--zak-text-muted); padding-top: 0.25rem; }
.line-chart-svg { width: 100%; height: 200px; }
.pie-chart { width: 200px; height: 200px; border-radius: 50%; }
.donut-chart { width: 200px; height: 200px; border-radius: 50%; position: relative; }
.donut-chart::after { content: ''; position: absolute; top: 30%; left: 30%; width: 40%; height: 40%; border-radius: 50%; background: var(--zak-bg); }
.area-chart-svg { width: 100%; height: 200px; }
.chart-legend { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 0.75rem; font-size: 0.8125rem; }
.chart-legend-item { display: flex; align-items: center; gap: 0.375rem; }
.chart-legend-dot { width: 10px; height: 10px; border-radius: 50%; }
.chart-grid line { stroke: var(--zak-border); stroke-dasharray: 4,4; }
.chart-tooltip { position: absolute; background: var(--zak-bg); border: 1px solid var(--zak-border); border-radius: var(--zak-radius-md); padding: 0.375rem 0.625rem; font-size: 0.75rem; box-shadow: var(--zak-shadow-md); pointer-events: none; z-index: 10; display: none; }
.zak-datagrid { width: 100%; border-collapse: collapse; font-size: 0.875rem; }
.zak-datagrid th { background: var(--zak-bg-subtle); font-weight: 600; text-align: left; padding: 0.625rem 0.75rem; border-bottom: 2px solid var(--zak-border); cursor: pointer; white-space: nowrap; user-select: none; position: sticky; top: 0; z-index: 1; }
.zak-datagrid th:hover { background: var(--zak-surface-hover); }
.zak-datagrid td { padding: 0.625rem 0.75rem; border-bottom: 1px solid var(--zak-border); }
.zak-datagrid tbody tr:nth-child(even) { background: var(--zak-bg-subtle); }
.zak-datagrid tbody tr:hover { background: var(--zak-surface-hover); }
.zak-datagrid .zak-row-selected { background: var(--zak-primary-50, #eff6ff) !important; }
.zak-datagrid-compact th, .zak-datagrid-compact td { padding: 0.375rem 0.5rem; font-size: 0.8125rem; }
.zak-datagrid-resize { position: relative; }
.zak-datagrid-resize::after { content: ''; position: absolute; right: 0; top: 0; bottom: 0; width: 4px; cursor: col-resize; background: transparent; }
.zak-datagrid-resize:hover::after { background: var(--zak-color-primary); }
* { box-sizing: border-box; }
.zak-docs-header { position: fixed; top: 0; left: 0; right: 0; height: 64px; background: var(--zak-surface, #fff); border-bottom: 1px solid var(--zak-border, #e2e8f0); z-index: 1030; display: flex; align-items: center; }
.zak-docs-header-inner { display: flex; align-items: center; gap: 16px; width: 100%; max-width: 1200px; margin: 0 auto; padding: 0 24px; }
.zak-docs-logo { font-size: 18px; font-weight: 700; color: var(--zak-text, #1e293b); text-decoration: none; }
.docs-sidebar-toggle { display: flex; align-items: center; padding: 6px; background: none; border: 1px solid var(--zak-border, #e2e8f0); border-radius: 8px; color: var(--zak-text, #1e293b); cursor: pointer; }
.zak-docs-header-actions { margin-left: auto; display: flex; align-items: center; gap: 8px; }
.zak-docs-search-btn { display: flex; align-items: center; gap: 8px; padding: 6px 12px; font-size: 14px; color: var(--zak-text-muted, #64748b); background: var(--zak-bg-subtle, #f1f5f9); border: 1px solid var(--zak-border, #e2e8f0); border-radius: 8px; cursor: pointer; }
.zak-docs-search-btn kbd { font-family: inherit; font-size: 12px; padding: 1px 6px; border: 1px solid var(--zak-border, #e2e8f0); border-radius: 4px; }
.zak-docs-theme-toggle { display: flex; align-items: center; padding: 6px; background: none; border: 1px solid var(--zak-border, #e2e8f0); border-radius: 8px; color: var(--zak-text, #1e293b); cursor: pointer; }
.docs-sidebar-nav { display: flex; flex-direction: column; gap: 8px; }
.docs-sidebar-section { border: 1px solid var(--zak-border, #e2e8f0); border-radius: 10px; background: var(--zak-bg, #f8fafc); overflow: hidden; }
.docs-sidebar-heading { width: 100%; padding: 10px 14px; text-align: left; font-size: 12px; font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase; color: var(--zak-text, #1e293b); background: none; border: 0; cursor: pointer; }
.docs-sidebar-section ul { list-style: none; margin: 0; padding: 0 8px 8px; }
.docs-sidebar-section.collapsed ul { display: none; }
.docs-sidebar-section ul a { display: block; padding: 6px 10px; font-size: 13px; color: var(--zak-text-muted, #64748b); text-decoration: none; border-radius: 6px; }
.docs-sidebar-section ul a:hover { background: var(--zak-primary-50, #dbeafe); color: var(--zak-color-primary, #3b82f6); }
.docs-sidebar-section ul a.sidebar-link-active { background: var(--zak-color-primary, #3b82f6); color: #fff; }
.zak-docs-main { margin-left: 280px; padding: 88px 32px 64px; }
.zak-docs-content { max-width: 960px; margin: 0 auto; }
.zak-docs-breadcrumb { font-size: 13px; color: var(--zak-text-muted, #64748b); margin: 0 0 16px; }
.zak-docs-breadcrumb a { color: var(--zak-text-muted, #64748b); text-decoration: none; }
.zak-docs-breadcrumb a:hover { color: var(--zak-color-primary, #3b82f6); }
.zak-docs-content h1 { margin: 0 0 8px; font-size: 32px; color: var(--zak-text, #1e293b); }
.zak-docs-description { margin: 0 0 32px; font-size: 16px; color: var(--zak-text-muted, #64748b); }
.zak-docs-section { margin-bottom: 24px; padding: 24px; background: var(--zak-surface, #fff); border: 1px solid var(--zak-border, #e2e8f0); border-radius: 12px; }
.zak-docs-section h2 { margin: 0 0 8px; font-size: 20px; color: var(--zak-text, #1e293b); }
.zak-docs-section > p { margin: 0 0 16px; font-size: 14px; color: var(--zak-text-muted, #64748b); }
.zak-docs-preview { margin-bottom: 16px; padding: 24px; background: var(--zak-bg, #f8fafc); border: 1px dashed var(--zak-border, #e2e8f0); border-radius: 8px; }
.zak-docs-code { position: relative; padding: 16px; background: #1e293b; border-radius: 8px; overflow-x: auto; }
.zak-docs-code pre { margin: 0; }
.zak-docs-code code { font-family: "SF Mono", "Fira Code", "Roboto Mono", Consolas, monospace; font-size: 13px; line-height: 1.6; color: #e2e8f0; }
.copy-code-btn { position: absolute; top: 8px; right: 8px; padding: 4px 10px; font-size: 12px; color: #fff; background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); border-radius: 6px; cursor: pointer; }
.zak-docs-section ul { padding-left: 20px; }
.zak-docs-section ul li { margin-bottom: 6px; font-size: 14px; color: var(--zak-text-muted, #475569); line-height: 1.6; }
.zak-docs-search-overlay { position: fixed; inset: 0; background: rgba(15,23,42,0.5); display: none; align-items: flex-start; justify-content: center; padding: 96px 16px 16px; z-index: 2000; }
.zak-docs-search-overlay.active { display: flex; }
.zak-docs-search-modal { width: 100%; max-width: 560px; background: var(--zak-surface, #fff); border-radius: 12px; overflow: hidden; }
.zak-docs-search-input { width: 100%; padding: 16px; font-size: 16px; border: 0; border-bottom: 1px solid var(--zak-border, #e2e8f0); outline: none; }
.zak-docs-search-results { max-height: 50vh; overflow-y: auto; padding: 8px; }
.zak-accordion { display: flex; flex-direction: column; gap: 0.5rem; }
.zak-accordion-item { border: 1px solid var(--zak-border, #e2e8f0); border-radius: 10px; background: var(--zak-surface, #fff); overflow: hidden; }
.zak-accordion-trigger { display: flex; width: 100%; align-items: center; gap: 10px; padding: 14px 16px; font-size: 15px; font-weight: 600; color: var(--zak-text, #1e293b); background: none; border: 0; cursor: pointer; text-align: left; }
.zak-accordion-trigger .zak-accordion-icon { margin-left: auto; width: 1rem; height: 1rem; transition: transform 0.2s ease; color: var(--zak-text-muted, #64748b); flex-shrink: 0; }
.zak-accordion-trigger:hover { color: var(--zak-color-primary, #3b82f6); }
.zak-accordion-item-active .zak-accordion-trigger .zak-accordion-icon { transform: rotate(180deg); }
.zak-accordion-item .zak-accordion-body { display: none; padding: 0 16px 16px; font-size: 14px; line-height: 1.6; color: var(--zak-text-muted, #475569); }
.zak-accordion-item-active .zak-accordion-body { display: block; }
.zak-accordion-item .zak-accordion-body.zak-accordion-content-active { display: block; }
.zak-icon { width: 1.25rem; height: 1.25rem; }
.zak-collapse-target { overflow: hidden; transition: height 0.3s ease; height: 0; max-height: none; opacity: 1; }
.zak-collapse-target.zak-collapse-active { height: auto; }
.coll-box { padding: 16px; background: var(--zak-surface, #fff); border: 1px solid var(--zak-border, #e2e8f0); border-radius: 10px; font-size: 14px; line-height: 1.6; color: var(--zak-text-muted, #475569); }
.zak-details { border: 1px solid var(--zak-border, #e2e8f0); border-radius: 12px; background: var(--zak-surface, #fff); overflow: hidden; }
.zak-details > summary { display: flex; align-items: center; gap: 10px; padding: 14px 16px; font-size: 15px; font-weight: 600; color: var(--zak-text, #1e293b); cursor: pointer; list-style: none; }
.zak-details > summary::-webkit-details-marker { display: none; }
.zak-details > summary::after { content: "\25B6"; margin-left: auto; color: var(--zak-text-muted, #64748b); font-size: 11px; transition: transform 0.2s ease; }
.zak-details[open] > summary::after { transform: rotate(90deg); }
.zak-details-content { border-top: 1px solid var(--zak-border, #e2e8f0); padding: 16px; font-size: 14px; line-height: 1.6; color: var(--zak-text-muted, #475569); }
details.details-default { border: 1px solid var(--zak-border, #e2e8f0); border-radius: 12px; background: var(--zak-surface, #fff); padding: 12px 16px; font-size: 14px; color: var(--zak-text-muted, #475569); line-height: 1.6; }
details.details-default summary { font-weight: 600; color: var(--zak-text, #1e293b); cursor: pointer; }
.zak-expandable-panel { border: 1px solid var(--zak-border, #e2e8f0); border-radius: 12px; background: var(--zak-surface, #fff); overflow: hidden; }
.zak-expandable-panel-header { display: flex; width: 100%; align-items: center; gap: 10px; padding: 16px; font-size: 15px; font-weight: 600; color: var(--zak-text, #1e293b); background: none; border: 0; cursor: pointer; text-align: left; }
.zak-expandable-panel-header .zak-icon { margin-left: auto; transition: transform 0.2s ease; color: var(--zak-text-muted, #64748b); flex-shrink: 0; }
.zak-expandable-panel.zak-expandable-panel-active .zak-expandable-panel-header .zak-icon { transform: rotate(180deg); }
.zak-collapse-target { overflow: hidden; height: 0; transition: height 0.3s ease; max-height: none; opacity: 1; }
.zak-expandable-panel-body { display: block; padding: 0 16px 16px; font-size: 14px; line-height: 1.6; color: var(--zak-text-muted, #475569); }
.zak-showmore-btn { display: inline-flex; align-items: center; gap: 4px; padding: 0; margin-top: 8px; font-size: var(--zak-font-size-sm, 14px); font-weight: 500; color: var(--zak-color-primary, #3b82f6); background: none; border: 0; cursor: pointer; }
.zak-showmore-btn:hover { color: var(--zak-color-primary-hover, #2563eb); text-decoration: underline; }
.zak-docs-show-more-demo { line-height: 1.65; }
.docs-border-demo {
                    width:120px; height:64px; border:1px solid var(--docs-border); border-radius:var(--docs-radius-sm);
                    display:flex; align-items:center; justify-content:center; font-size:12px; color:var(--docs-text-muted);
                    background:var(--docs-preview-bg);
                }
.docs-border-side {
                    width:120px; height:56px; display:flex; align-items:center; justify-content:center;
                    font-size:12px; color:var(--docs-text-muted); background:var(--docs-preview-bg);
                }
.docs-radius-demo {
                    width:72px; height:56px; border:1px solid var(--docs-border);
                    display:flex; align-items:center; justify-content:center; font-size:11px; color:var(--docs-text-muted);
                    background:var(--docs-preview-bg);
                }
.docs-color-row { display:flex; flex-wrap:wrap; gap:8px; width:100%; }
.docs-color-widget .docs-color-row { margin-bottom:8px; }
.docs-color-swatch {
                    flex:1 1 60px; min-width:80px; height:64px; border-radius:var(--docs-radius-sm);
                    display:flex; flex-direction:column; align-items:flex-start; justify-content:flex-end;
                    padding:8px; font-size:12px; font-family:var(--docs-font-mono);
                    cursor:pointer; border:1px solid rgba(0,0,0,0.06); line-height:1.3;
                }
.docs-color-hex { font-size:10px; opacity:0.85; }
.docs-color-swatch:hover { transform:scale(1.03); box-shadow:var(--docs-shadow-lg); }
.docs-icon-tile {
                    display:flex; flex-direction:column; align-items:center; gap:6px;
                    padding:12px 6px; border:1px solid var(--docs-border); border-radius:var(--docs-radius-sm);
                    background:var(--docs-bg); color:var(--docs-text); cursor:pointer;
                    font-size:11px; font-family:var(--docs-font); transition:all var(--docs-transition);
                }
.docs-icon-tile:hover { border-color:var(--docs-accent); box-shadow:var(--docs-shadow); }
.docs-icon-tile--copied { border-color:var(--docs-success); color:var(--docs-success); }
.docs-icon-size { display:flex; flex-direction:column; align-items:center; gap:8px; padding:8px; color:var(--docs-text); }
.docs-icon-size span { font-size:12px; color:var(--docs-text-muted); }
.docs-hover-card { cursor:pointer; transition:box-shadow var(--zak-transition-base), transform var(--zak-transition-base); }
.docs-hover-card:hover { box-shadow: var(--zak-shadow-xl); transform: translateY(-4px); }
.docs-shadow-demo {
                    width:170px; height:88px; border-radius:var(--docs-radius-lg);
                    display:flex; align-items:flex-end; padding:12px; font-size:12px; color:var(--docs-text-muted);
                    background:var(--docs-preview-bg); border:1px solid var(--docs-border);
                }
.zak-docs-preview .zak-menu { position: absolute; top: 100%; left: 0; margin-top: 0.25rem; }
.zak-docs-preview .zak-menu:not(.visible) { display: none; }
.zak-docs-preview { position: relative; }
.zak-docs-preview .zak-navbar-fixed { position: absolute; }
.zak-docs-preview .zak-sidebar { position: relative; min-height: 0; top: auto; left: auto; bottom: auto; transform: none !important; }
.zak-docs-preview .zak-sidebar.zak-sidebar-fixed { position: absolute; }
.zak-context-menu { display: none; position: fixed; z-index: 1090; min-width: 13rem; padding: 6px; background: var(--zak-surface, #fff); border: 1px solid var(--zak-border, #e2e8f0); border-radius: 12px; box-shadow: var(--zak-shadow-lg, 0 10px 25px rgba(0,0,0,0.12)); }
.zak-context-menu.zak-context-menu-active { display: block; }
.zak-menu-header { padding: 10px 12px 6px; font-size: 12px; font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase; color: var(--zak-text-muted, #64748b); }
.zak-menu-item { display: flex; width: 100%; align-items: center; gap: 10px; padding: 8px 12px; font-size: 14px; color: var(--zak-text, #1e293b); background: none; border: 0; border-radius: 8px; text-align: left; cursor: pointer; }
.zak-menu-item:hover { background: var(--zak-primary-50, #eff6ff); color: var(--zak-color-primary, #3b82f6); }
.zak-menu-item.is-disabled { opacity: 0.5; pointer-events: none; }
.zak-menu-item.is-danger { color: var(--zak-color-danger, #ef4444); }
.zak-menu-item.is-danger:hover { background: var(--zak-danger-50, #fef2f2); color: var(--zak-color-danger, #ef4444); }
.zak-menu-divider { height: 1px; margin: 6px 8px; background: var(--zak-border, #e2e8f0); border: 0; }
.zak-menu-item .icon { width: 1rem; height: 1rem; flex-shrink: 0; }
.ctx-target { padding: 40px 20px; border: 2px dashed var(--zak-primary-300, #93c5fd); border-radius: 12px; text-align: center; color: var(--zak-text-muted, #64748b); font-size: 14px; background: var(--zak-primary-50, #eff6ff); cursor: context-menu; user-select: none; }
.ctx-target:hover { border-color: var(--zak-color-primary, #3b82f6); }
.icon { width: 1.25rem; height: 1.25rem; }
.zak-modal.zak-modal-active { display: flex; }
.zak-drawer-overlay { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: var(--zak-backdrop-bg, rgba(15,23,42,0.5)); z-index: 1045; opacity: 0; transition: opacity 0.3s ease; }
.zak-drawer-overlay-active { opacity: 1; }
.zak-drawer.zak-drawer-active .zak-drawer-content { transform: translate(0, 0) !important; }
.push-demo { position: relative; height: 260px; overflow: hidden; border: 1px solid var(--zak-border, #e2e8f0); border-radius: 12px; background: var(--zak-surface, #fff); }
.push-demo nav { width: 200px; height: 100%; position: absolute; top: 0; left: 0; background: var(--zak-secondary-900, #0f172a); color: #fff; padding: 16px; transition: transform 0.3s ease; z-index: 5; }
.push-demo nav a { display: block; padding: 8px 10px; color: #cbd5e1; text-decoration: none; font-size: 14px; border-radius: 6px; }
.push-demo nav a:hover { color: #fff; background: rgba(255,255,255,0.1); }
.push-demo .content { position: absolute; top: 0; left: 0; right: 0; bottom: 0; padding: 16px 16px 16px 216px; transition: padding 0.3s ease; }
.push-demo.collapsed nav { transform: translateX(-100%); }
.push-demo.collapsed .content { padding-left: 16px; }
.zak-dropdown { display: inline-block; position: relative; }
.zak-dropdown-menu { display: none; position: absolute; top: 100%; right: 0; z-index: 1070; min-width: 14rem; max-height: 20rem; overflow-y: auto; padding: 6px; background: var(--zak-surface, #fff); border: 1px solid var(--zak-border, #e2e8f0); border-radius: 12px; box-shadow: var(--zak-shadow-lg, 0 10px 25px rgba(0,0,0,0.1)); margin-top: 4px; }
.zak-dropdown-menu.zak-dropdown-active { display: block; }
.zak-dropdown-menu-left { left: 0; right: auto; }
.zak-dropdown-menu-right { left: auto; right: 0; }
.zak-menu-item { display: flex; width: 100%; align-items: center; gap: 10px; padding: 8px 12px; font-size: 14px; color: var(--zak-text, #1e293b); background: none; border: 0; border-radius: 8px; text-align: left; cursor: pointer; text-decoration: none; }
.zak-dropdown.hover-all .zak-dropdown-menu { transition: none; }
.icon { display: inline-block; width: 1.25rem; height: 1.25rem; }
.zak-offcanvas-overlay { position: fixed; inset: 0; background: var(--zak-backdrop-bg, rgba(15,23,42,0.5)); z-index: 1045; opacity: 0; transition: opacity 0.3s ease; }
.zak-offcanvas-overlay-active { opacity: 1; }
.zak-offcanvas-surface { position: fixed; z-index: 1050; background: var(--zak-surface, #fff); transition: transform 0.3s ease; box-shadow: var(--zak-shadow-xl); }
.zak-offcanvas-surface-start { top: 0; left: 0; bottom: 0; width: 20rem; transform: translateX(-100%); }
.zak-offcanvas-surface-end { top: 0; right: 0; bottom: 0; width: 20rem; transform: translateX(100%); }
.zak-offcanvas-surface-top { top: 0; left: 0; right: 0; height: 16rem; transform: translateY(-100%); }
.zak-offcanvas-surface-bottom { bottom: 0; left: 0; right: 0; height: 16rem; transform: translateY(100%); }
.zak-offcanvas.zak-offcanvas-active .zak-offcanvas-surface { transform: translate(0, 0) !important; }
.zak-popover { display: none; position: absolute; z-index: 1060; min-width: 14rem; max-width: 22rem; background: var(--zak-surface, #fff); border: 1px solid var(--zak-border, #e2e8f0); border-radius: 12px; box-shadow: var(--zak-shadow-lg, 0 10px 25px rgba(0,0,0,0.1)); padding: 16px; }
.zak-popover.zak-popover-active { display: block; }
.zak-popover-header { margin: 0 0 6px; font-size: 15px; font-weight: 600; color: var(--zak-text, #1e293b); }
.zak-popover-body { font-size: 13px; line-height: 1.5; color: var(--zak-text-muted, #475569); }
.zak-popover-footer { margin-top: 12px; display: flex; gap: 0.5rem; justify-content: flex-end; }
.zak-tooltip { display: none; position: absolute; z-index: 1080; max-width: 16rem; padding: 6px 10px; font-size: 12px; line-height: 1.4; color: var(--zak-tooltip-text, #fff); background: var(--zak-tooltip-bg, #0f172a); border-radius: 6px; box-shadow: var(--zak-shadow-md, 0 4px 10px rgba(0,0,0,0.15)); pointer-events: none; white-space: nowrap; }
.zak-tooltip.zak-tooltip-active { display: block; }
.tt-triggers { display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; }
.tt-triggers .zak-btn, .tt-triggers input { position: relative; }
.zak-calendar { display: inline-flex; flex-direction: column; gap: 12px; padding: 16px; background: var(--zak-surface, #fff); border: 1px solid var(--zak-border, #e2e8f0); border-radius: 12px; box-shadow: 0 4px 12px rgba(15,23,42,0.06); min-width: 18rem; user-select: none; }
.zak-calendar-header { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
.zak-calendar-title { font-size: 14px; font-weight: 600; color: var(--zak-text, #1e293b); }
.zak-calendar-nav { display: flex; align-items: center; gap: 4px; }
.zak-calendar-nav-btn { display: flex; align-items: center; justify-content: center; width: 2rem; height: 2rem; border-radius: 8px; font-size: 14px; color: var(--zak-text-muted, #64748b); cursor: pointer; background: none; border: 1px solid var(--zak-border, #e2e8f0); }
.zak-calendar-nav-btn:hover { background: var(--zak-bg-subtle, #f1f5f9); color: var(--zak-text, #1e293b); }
.zak-calendar-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 2px; }
.zak-calendar-weekday { text-align: center; padding: 4px 0; font-size: 11px; font-weight: 600; color: var(--zak-text-subtle, #94a3b8); text-transform: uppercase; }
.zak-calendar-day { display: flex; align-items: center; justify-content: center; height: 2.25rem; font-size: 14px; color: var(--zak-text, #1e293b); border-radius: 8px; cursor: pointer; background: none; border: 0; }
.zak-calendar-day:hover { background: var(--zak-bg-subtle, #f1f5f9); }
.zak-calendar-day.zak-outside { color: var(--zak-text-subtle, #94a3b8); opacity: 0.5; }
.zak-calendar-day.zak-today { color: var(--zak-color-primary, #3b82f6); font-weight: 600; }
.zak-calendar-day.zak-selected { background: var(--zak-color-primary, #3b82f6); color: #fff; font-weight: 600; }
.zak-calendar-day.zak-selected:hover { background: var(--zak-color-primary-hover, #2563eb); color: #fff; }
.zak-calendar-day:disabled { opacity: 0.4; cursor: not-allowed; }
.zak-calendar-day:disabled:hover { background: transparent; }
.zak-calendar-day.zak-in-range { background: var(--zak-primary-100, #dbeafe); color: var(--zak-primary-800, #1e40af); border-radius: 0; }
.zak-calendar-day.zak-range-start, .zak-calendar-day.zak-range-end { background: var(--zak-color-primary, #3b82f6); color: #fff; font-weight: 600; border-radius: 8px; }
.zak-calendar-footer { display: flex; justify-content: flex-end; gap: 8px; padding-top: 12px; border-top: 1px solid var(--zak-border, #e2e8f0); }
.zak-event-log { margin: 14px 0 0; font-size: 13px; color: var(--zak-text-muted, #64748b); font-family: "SF Mono", "Fira Code", Consolas, monospace; }
.zak-colorpicker { position: relative; display: inline-block; }
.zak-colorpicker-swatch { display: inline-block; width: 3rem; height: 2.5rem; border: 1px solid var(--zak-border, #e2e8f0); border-radius: 10px; cursor: pointer; box-shadow: 0 1px 3px rgba(15,23,42,0.1); transition: border-color var(--zak-transition-fast, 0.15s), box-shadow var(--zak-transition-fast, 0.15s); }
.zak-colorpicker-swatch:hover { border-color: var(--zak-color-primary, #3b82f6); box-shadow: 0 0 0 3px rgba(59,130,246,0.15); }
.zak-colorpicker-popup { position: absolute; top: calc(100% + 6px); left: 0; z-index: 50; padding: 16px; background: var(--zak-surface, #fff); border: 1px solid var(--zak-border, #e2e8f0); border-radius: 12px; box-shadow: 0 10px 24px rgba(15,23,42,0.12); display: none; }
.zak-colorpicker-popup.zak-colorpicker-popup-active { display: block; }
.zak-colorpicker-presets { display: grid; grid-template-columns: repeat(5, 1fr); gap: 8px; }
.zak-colorpicker-color { width: 2rem; height: 2rem; border: 2px solid transparent; border-radius: 8px; cursor: pointer; }
.zak-colorpicker-color.selected { border-color: var(--zak-text, #1e293b); }
.zak-colorpicker-custom { display: flex; align-items: center; gap: 8px; margin-top: 12px; padding-top: 12px; border-top: 1px solid var(--zak-border, #e2e8f0); font-size: 13px; color: var(--zak-text-muted, #64748b); }
.zak-colorpicker-native { width: 2rem; height: 2rem; padding: 0; background: none; border: 1px solid var(--zak-border, #e2e8f0); border-radius: 6px; cursor: pointer; }
.zak-docs-color-demo { width: 100%; max-width: 24rem; height: 3.5rem; margin-top: 16px; border-radius: 10px; border: 1px solid var(--zak-border, #e2e8f0); display: flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 600; color: #fff; text-shadow: 0 1px 2px rgba(0,0,0,0.4); transition: background-color 0.2s ease; }
.zak-event-log { margin: 12px 0 0; font-size: 13px; color: var(--zak-text-muted, #64748b); font-family: "SF Mono", "Fira Code", Consolas, monospace; }
.zak-datepicker { position: relative; }
.zak-datepicker-popup { position: absolute; top: calc(100% + 6px); left: 0; z-index: 50; min-width: 17rem; padding: 16px; background: var(--zak-surface, #fff); border: 1px solid var(--zak-border, #e2e8f0); border-radius: 12px; box-shadow: 0 10px 24px rgba(15,23,42,0.12); display: none; }
.zak-datepicker-popup.zak-datepicker-popup-active { display: block; }
.zak-datepicker-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; }
.zak-datepicker-month { font-size: 14px; font-weight: 600; color: var(--zak-text, #1e293b); }
.zak-datepicker-prev, .zak-datepicker-next { display: flex; align-items: center; justify-content: center; width: 2rem; height: 2rem; font-size: 16px; color: var(--zak-text-muted, #64748b); background: none; border: 1px solid var(--zak-border, #e2e8f0); border-radius: 8px; cursor: pointer; }
.zak-datepicker-prev:hover, .zak-datepicker-next:hover { color: var(--zak-color-primary, #3b82f6); }
.zak-datepicker-weekdays { display: grid; grid-template-columns: repeat(7, 1fr); margin-bottom: 4px; text-align: center; }
.zak-datepicker-weekdays span { padding: 4px 0; font-size: 11px; font-weight: 600; text-transform: uppercase; color: var(--zak-text-subtle, #94a3b8); }
.zak-datepicker-days { display: grid; grid-template-columns: repeat(7, 1fr); gap: 2px; }
.zak-datepicker-day { display: flex; align-items: center; justify-content: center; height: 2.25rem; font-size: 14px; color: var(--zak-text, #1e293b); background: none; border: 0; border-radius: 8px; cursor: pointer; }
.zak-datepicker-day:hover { background: var(--zak-primary-50, #dbeafe); color: var(--zak-color-primary, #3b82f6); }
.zak-datepicker-day.empty { pointer-events: none; }
.zak-datepicker-day.disabled { opacity: 0.4; cursor: not-allowed; }
.zak-datepicker-day.disabled:hover { background: none; color: inherit; }
.zak-datepicker-day.today { color: var(--zak-color-primary, #3b82f6); font-weight: 600; }
.zak-datepicker-day.selected { background: var(--zak-color-primary, #3b82f6); color: #fff; font-weight: 600; }
.zak-datepicker-day.selected:hover { background: var(--zak-color-primary-hover, #2563eb); color: #fff; }
.zak-input { width: 100%; max-width: 20rem; padding: 10px 12px; font-size: 14px; color: var(--zak-text, #1e293b); background: var(--zak-surface, #fff); border: 1px solid var(--zak-border, #e2e8f0); border-radius: 8px; outline: none; }
.zak-input:focus { border-color: var(--zak-color-primary, #3b82f6); box-shadow: 0 0 0 3px rgba(59,130,246,0.15); }
.zak-range-picker { display: inline-block; position: relative; }
.zak-range-field { display: inline-flex; align-items: center; gap: 8px; width: 100%; max-width: 22rem; padding: 10px 12px; font-size: 14px; color: var(--zak-text, #1e293b); background: var(--zak-surface, #fff); border: 1px solid var(--zak-border, #e2e8f0); border-radius: 8px; cursor: pointer; user-select: none; }
.zak-range-field:hover { border-color: var(--zak-color-primary, #3b82f6); }
.zak-range-sep { color: var(--zak-text-subtle, #94a3b8); }
.zak-range-popup { position: absolute; top: calc(100% + 6px); left: 0; z-index: 50; background: var(--zak-surface, #fff); border: 1px solid var(--zak-border, #e2e8f0); border-radius: 12px; box-shadow: 0 10px 24px rgba(15,23,42,0.12); padding: 12px; display: none; }
.zak-range-popup.zak-range-popup-active { display: block; }
.zak-calendar:focus-visible { outline: 2px solid var(--zak-color-primary, #3b82f6); outline-offset: 2px; }
.zak-preset-row { display: flex; gap: 6px; margin-bottom: 10px; flex-wrap: wrap; }
.zak-preset-chip { padding: 4px 10px; font-size: 12px; font-weight: 500; color: var(--zak-text-muted, #64748b); background: var(--zak-bg-subtle, #f1f5f9); border: 1px solid var(--zak-border, #e2e8f0); border-radius: 999px; cursor: pointer; }
.zak-preset-chip:hover { border-color: var(--zak-color-primary, #3b82f6); color: var(--zak-color-primary, #3b82f6); }
.zak-datetime-picker { display: inline-block; position: relative; }
.zak-datetime-field { display: inline-flex; align-items: center; gap: 8px; padding: 10px 12px; font-size: 14px; color: var(--zak-text, #1e293b); background: var(--zak-surface, #fff); border: 1px solid var(--zak-border, #e2e8f0); border-radius: 8px; cursor: pointer; user-select: none; width: 100%; max-width: 20rem; }
.zak-datetime-field:hover { border-color: var(--zak-color-primary, #3b82f6); }
.zak-datetime-popup { position: absolute; top: calc(100% + 6px); left: 0; z-index: 50; padding: 16px; background: var(--zak-surface, #fff); border: 1px solid var(--zak-border, #e2e8f0); border-radius: 12px; box-shadow: 0 10px 24px rgba(15,23,42,0.12); display: none; }
.zak-datetime-popup.zak-datetime-popup-active { display: block; }
.zak-datetime-divider { margin: 12px 0; border: 0; border-top: 1px solid var(--zak-border, #e2e8f0); }
.zak-datetime-time { display: flex; align-items: center; justify-content: center; gap: 14px; }
.zak-timepicker-column { display: flex; flex-direction: column; align-items: center; gap: 2px; }
.zak-timepicker-spin-up, .zak-timepicker-spin-down { display: flex; align-items: center; justify-content: center; width: 2rem; height: 2rem; font-size: 12px; color: var(--zak-text-muted, #64748b); background: none; border: 1px solid var(--zak-border, #e2e8f0); border-radius: 8px; cursor: pointer; }
.zak-timepicker-spin-up:hover, .zak-timepicker-spin-down:hover { color: var(--zak-color-primary, #3b82f6); border-color: var(--zak-color-primary, #3b82f6); }
.zak-timepicker-hour, .zak-timepicker-minute { min-width: 2.5rem; text-align: center; font-size: 22px; font-weight: 600; color: var(--zak-text, #1e293b); }
.zak-timepicker-separator { font-size: 20px; font-weight: 600; color: var(--zak-text-muted, #64748b); }
.zak-datetime-footer { display: flex; justify-content: flex-end; gap: 8px; margin-top: 14px; padding-top: 12px; border-top: 1px solid var(--zak-border, #e2e8f0); }
.zak-month-picker { display: inline-block; position: relative; }
.zak-month-field { display: inline-flex; align-items: center; gap: 8px; padding: 10px 12px; font-size: 14px; color: var(--zak-text, #1e293b); background: var(--zak-surface, #fff); border: 1px solid var(--zak-border, #e2e8f0); border-radius: 8px; cursor: pointer; user-select: none; min-width: 12rem; }
.zak-month-field:hover { border-color: var(--zak-color-primary, #3b82f6); }
.zak-month-popup { position: absolute; top: calc(100% + 6px); left: 0; z-index: 50; padding: 16px; background: var(--zak-surface, #fff); border: 1px solid var(--zak-border, #e2e8f0); border-radius: 12px; box-shadow: 0 10px 24px rgba(15,23,42,0.12); display: none; }
.zak-month-popup.zak-month-popup-active { display: block; }
.zak-month-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; }
.zak-month-cell { display: flex; align-items: center; justify-content: center; height: 2.5rem; font-size: 14px; font-weight: 500; color: var(--zak-text, #1e293b); background: var(--zak-bg-subtle, #f1f5f9); border: 1px solid transparent; border-radius: 8px; cursor: pointer; }
.zak-month-cell:hover { border-color: var(--zak-color-primary, #3b82f6); color: var(--zak-color-primary, #3b82f6); }
.zak-month-cell.zak-selected { background: var(--zak-color-primary, #3b82f6); color: #fff; font-weight: 600; }
.zak-month-cell.zak-current { color: var(--zak-color-primary, #3b82f6); font-weight: 600; }
.zak-month-cell.zak-selected.zak-current { color: #fff; }
.zak-month-cell:disabled { opacity: 0.4; cursor: not-allowed; }
.zak-timepicker { position: relative; }
.zak-timepicker-popup { position: absolute; top: calc(100% + 6px); left: 0; z-index: 50; min-width: 13rem; padding: 16px; background: var(--zak-surface, #fff); border: 1px solid var(--zak-border, #e2e8f0); border-radius: 12px; box-shadow: 0 10px 24px rgba(15,23,42,0.12); display: none; }
.zak-timepicker-popup.zak-timepicker-popup-active { display: block; }
.zak-timepicker-header { display: flex; align-items: center; justify-content: center; gap: 14px; }
.zak-timepicker-hour, .zak-timepicker-minute { min-width: 2.5rem; text-align: center; font-size: 24px; font-weight: 600; color: var(--zak-text, #1e293b); }
.zak-timepicker-separator { font-size: 22px; font-weight: 600; color: var(--zak-text-muted, #64748b); }
.zak-timepicker-footer { display: flex; justify-content: flex-end; gap: 8px; margin-top: 14px; }
.zak-year-picker { display: inline-block; position: relative; }
.zak-year-field { display: inline-flex; align-items: center; gap: 8px; padding: 10px 12px; font-size: 14px; color: var(--zak-text, #1e293b); background: var(--zak-surface, #fff); border: 1px solid var(--zak-border, #e2e8f0); border-radius: 8px; cursor: pointer; user-select: none; min-width: 12rem; }
.zak-year-field:hover { border-color: var(--zak-color-primary, #3b82f6); }
.zak-year-popup { position: absolute; top: calc(100% + 6px); left: 0; z-index: 50; padding: 16px; background: var(--zak-surface, #fff); border: 1px solid var(--zak-border, #e2e8f0); border-radius: 12px; box-shadow: 0 10px 24px rgba(15,23,42,0.12); display: none; }
.zak-year-popup.zak-year-popup-active { display: block; }
.zak-year-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; }
.zak-year-cell { display: flex; align-items: center; justify-content: center; height: 2.5rem; font-size: 14px; font-weight: 500; color: var(--zak-text, #1e293b); background: var(--zak-bg-subtle, #f1f5f9); border: 1px solid transparent; border-radius: 8px; cursor: pointer; }
.zak-year-cell:hover { border-color: var(--zak-color-primary, #3b82f6); color: var(--zak-color-primary, #3b82f6); }
.zak-year-cell.zak-selected { background: var(--zak-color-primary, #3b82f6); color: #fff; font-weight: 600; }
.zak-year-cell.zak-current { color: var(--zak-color-primary, #3b82f6); font-weight: 600; }
.zak-year-cell.zak-selected.zak-current { color: #fff; }
.zak-year-cell:disabled { opacity: 0.4; cursor: not-allowed; }
.ico-grid { display:grid;grid-template-columns:repeat(auto-fill,minmax(132px,1fr));gap:12px; }
.ico-cell { display:flex;flex-direction:column;align-items:center;gap:10px;padding:18px 10px;border:1px solid var(--docs-border);border-radius:var(--docs-radius);background:var(--docs-surface);cursor:pointer;transition:border-color 0.15s,box-shadow 0.15s,transform 0.15s;position:relative; }
.ico-cell:hover { border-color:var(--docs-accent);box-shadow:var(--docs-shadow-sm);transform:translateY(-2px); }
.ico-cell__name { font-size:12px;color:var(--docs-text-muted);text-align:center;word-break:break-all; }
.ico-cell--copied::after { content:'Copied!';position:absolute;top:-10px;left:50%;transform:translateX(-50%);font-size:11px;font-weight:600;color:#fff;background:var(--docs-accent);padding:2px 8px;border-radius:8px;white-space:nowrap; }
.ico-filter { display:flex;align-items:center;gap:10px;padding:12px 16px;border:1px solid var(--docs-border);border-radius:var(--docs-radius);background:var(--docs-surface);margin-bottom:20px; }
.ico-filter input { width:100%;border:none;outline:none;background:transparent;font-size:15px;color:var(--docs-text); }
.ico-count { font-size:13px;color:var(--docs-text-muted);flex-shrink:0; }
.ico-demo { display:inline-flex;flex-direction:column;align-items:center;gap:8px; }
.ico-demo__label { font-size:12px;color:var(--docs-text-muted); }
.search-page__input-wrap { display:flex;align-items:center;gap:12px;padding:16px 20px;border:2px solid var(--docs-border);border-radius:var(--docs-radius);background:var(--docs-surface);transition:border-color 0.2s,box-shadow 0.2s;margin-bottom:12px; }
.search-page__input-wrap:focus-within { border-color:var(--docs-accent);box-shadow:0 0 0 3px color-mix(in srgb, var(--docs-accent) 20%, transparent); }
.search-page__input-wrap svg { color:var(--docs-text-muted);flex-shrink:0; }
.search-page__input { flex:1;border:none;outline:none;background:transparent;font-size:18px;color:var(--docs-text); }
.search-page__hint { font-size:13px;color:var(--docs-text-muted);margin-bottom:20px; }
.search-tabs { display:flex;flex-wrap:wrap;gap:8px;margin-bottom:24px; }
.search-tab { padding:6px 14px;font-size:13px;font-weight:500;border:1px solid var(--docs-border);border-radius:14px;background:var(--docs-surface);color:var(--docs-text-muted);cursor:pointer;transition:all 0.15s; }
.search-tab:hover { border-color:var(--docs-accent);color:var(--docs-text); }
.search-tab--active { background:var(--docs-accent);border-color:var(--docs-accent);color:#fff; }
.search-results { display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:16px; }
.search-card { display:block;padding:16px 18px;border:1px solid var(--docs-border);border-radius:var(--docs-radius);background:var(--docs-surface);text-decoration:none;transition:border-color 0.15s,box-shadow 0.15s,transform 0.15s; }
.search-card:hover { border-color:var(--docs-accent);box-shadow:var(--docs-shadow-sm);transform:translateY(-2px);text-decoration:none; }
.search-card--active { border-color:var(--docs-accent);box-shadow:var(--docs-shadow-sm); }
.search-card__name { display:flex;align-items:center;justify-content:space-between;gap:8px;font-weight:600;color:var(--docs-text);margin-bottom:4px; }
.search-card__category { flex-shrink:0;padding:2px 8px;font-size:11px;font-weight:600;border-radius:10px;background:var(--docs-bg);border:1px solid var(--docs-border);color:var(--docs-text-muted); }
.search-card__desc { font-size:13px;line-height:1.5;color:var(--docs-text-muted);margin:0; }
.search-group { margin-bottom:28px; }
.search-group__title { font-size:14px;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;color:var(--docs-text-muted);margin:0 0 12px; }
.search-group .search-results { grid-template-columns:repeat(auto-fill,minmax(300px,1fr)); }
.search-empty { padding:48px 20px;text-align:center;border:1px dashed var(--docs-border);border-radius:var(--docs-radius);color:var(--docs-text-muted); }
.search-count { font-size:13px;color:var(--docs-text-muted);margin-bottom:16px; }
.tpl-grid { display:grid;grid-template-columns:repeat(auto-fill,minmax(340px,1fr));gap:24px; }
.tpl-card { background:var(--docs-surface);border:1px solid var(--docs-border);border-radius:var(--docs-radius);overflow:hidden;transition:transform 0.2s,box-shadow 0.2s; }
.tpl-card:hover { transform:translateY(-4px);box-shadow:var(--docs-shadow-lg); }
.tpl-card__preview { height:200px;display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden; }
.tpl-card__preview-text { font-size:1.25rem;font-weight:700;color:rgba(255,255,255,0.9);z-index:1; }
.tpl-card__body { padding:20px; }
.tpl-card__name { font-size:1.125rem;font-weight:600;margin:0 0 4px;color:var(--docs-text); }
.tpl-card__desc { font-size:14px;color:var(--docs-text-muted);margin:0 0 16px;line-height:1.5; }
.tpl-card__meta { display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px; }
.tpl-card__badges { display:flex;gap:4px;flex-wrap:wrap; }
.tpl-card__badge { display:inline-flex;padding:2px 8px;font-size:11px;font-weight:600;border-radius:10px;background:var(--docs-bg);border:1px solid var(--docs-border);color:var(--docs-text-muted); }
.tpl-card__link { display:inline-flex;align-items:center;gap:6px;padding:6px 14px;font-size:13px;font-weight:500;color:#fff;background:var(--docs-accent);border:none;border-radius:var(--docs-radius-sm);cursor:pointer;text-decoration:none;transition:opacity 0.2s; }
.tpl-card__link:hover { opacity:0.85;text-decoration:none;color:#fff; }
.util-grid { display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:8px; }
.util-demo { display:flex;align-items:center;justify-content:center;padding:12px;background:var(--docs-surface);border:1px solid var(--docs-border);border-radius:var(--docs-radius-sm);font-size:13px;font-family:var(--docs-font-mono);color:var(--docs-text);transition:border-color 0.2s;cursor:default; }
.util-demo:hover { border-color:var(--docs-accent); }
.util-demo__box { width:48px;height:32px;border-radius:4px;display:flex;align-items:center;justify-content:center; }
.util-demo__box--primary { background:var(--docs-accent);color:#fff; }
.util-demo__box--muted { background:var(--docs-border);color:var(--docs-text); }
.util-category { margin-bottom:40px; }
.util-category > h3 { font-size:1.125rem;font-weight:600;margin:0 0 12px;color:var(--docs-text); }


/* ============================================================
   ZAKUIKIT RUNTIME STATE OVERRIDES
   Styles for classes created/toggled by dist/js/zak.js at runtime.
   Mirrors existing component conventions so that JS-driven states,
   popups and animations render in the docs site.
   ============================================================ */

/* ---------- Accordion (JS toggles trigger + content) ---------- */
.zak-accordion-trigger.zak-accordion-active { color: var(--zak-color-primary); }
.zak-accordion-trigger.zak-accordion-active .zak-accordion-icon { transform: rotate(180deg); color: var(--zak-color-primary); }
.zak-accordion .zak-accordion-body { overflow: hidden; transition: height var(--zak-transition-base); }

/* ---------- Autocomplete (JS builds list + items) ---------- */
.zak-autocomplete-list { position: absolute; top: calc(100% + 0.25rem); left: 0; right: 0; max-height: 20rem; overflow-y: auto; background-color: var(--zak-surface); border: 1px solid var(--zak-border); border-radius: var(--zak-radius-md); box-shadow: var(--zak-shadow-md); padding: var(--zak-space-1); display: none; z-index: var(--zak-z-dropdown); }
.zak-autocomplete-list.zak-autocomplete-list-active { display: block; }
.zak-autocomplete-list .zak-autocomplete-item { padding: 0.5rem 0.75rem; font-size: var(--zak-font-size-sm); color: var(--zak-text); cursor: pointer; border-radius: var(--zak-radius-sm); }
.zak-autocomplete-list .zak-autocomplete-item:hover,
.zak-autocomplete-list .zak-autocomplete-item.zak-autocomplete-item-active { background-color: rgba(59, 130, 246, 0.08); color: var(--zak-color-primary); }

/* ---------- Combobox (JS transforms <select>) ---------- */
.zak-combobox { position: relative; }
.zak-combobox-trigger { display: flex; align-items: center; justify-content: space-between; gap: var(--zak-space-2); padding: 0.5rem 0.75rem; border: 1px solid var(--zak-border); border-radius: var(--zak-radius-md); background-color: var(--zak-surface); cursor: pointer; }
.zak-combobox-value { color: var(--zak-text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.zak-combobox-arrow { width: 0; height: 0; border: 5px solid transparent; border-top-color: var(--zak-text-muted); flex: none; }
.zak-combobox-search { width: 100%; }
.zak-combobox-listbox { max-height: 16rem; overflow-y: auto; padding: var(--zak-space-1); display: none; }
.zak-combobox.zak-combobox-active .zak-combobox-listbox { display: block; position: absolute; top: calc(100% + 0.25rem); left: 0; right: 0; background-color: var(--zak-surface); border: 1px solid var(--zak-border); border-radius: var(--zak-radius-md); box-shadow: var(--zak-shadow-md); z-index: var(--zak-z-dropdown); }
.zak-combobox-option { padding: 0.5rem 0.75rem; font-size: var(--zak-font-size-sm); color: var(--zak-text); cursor: pointer; border-radius: var(--zak-radius-sm); }
.zak-combobox-option:hover,
.zak-combobox-option.selected { background-color: rgba(59, 130, 246, 0.08); color: var(--zak-color-primary); }
.zak-combobox-option.disabled { opacity: 0.5; cursor: not-allowed; }

/* ---------- Cascader (JS builds panels/options) ---------- */
.zak-cascader-trigger { display: flex; align-items: center; padding: 0.5rem 0.75rem; border: 1px solid var(--zak-border); border-radius: var(--zak-radius-md); background-color: var(--zak-surface); cursor: pointer; }
.zak-cascader-value { color: var(--zak-text-muted); }
.zak-cascader-panels { position: absolute; top: calc(100% + 0.25rem); left: 0; display: none; z-index: var(--zak-z-dropdown); }
.zak-cascader.zak-cascader-active .zak-cascader-panels { display: flex; }
.zak-cascader-option { display: flex; align-items: center; justify-content: space-between; padding: 0.5rem 0.75rem; font-size: var(--zak-font-size-sm); color: var(--zak-text); cursor: pointer; white-space: nowrap; }
.zak-cascader-option:hover,
.zak-cascader-option.active { background-color: rgba(59, 130, 246, 0.08); color: var(--zak-color-primary); }
.zak-cascader-option.disabled { opacity: 0.5; cursor: not-allowed; }

/* ---------- Context menu (JS clones menu markup) ---------- */
.zak-context-menu { display: none; min-width: 11rem; background-color: var(--zak-surface); border: 1px solid var(--zak-border); border-radius: var(--zak-radius-md); box-shadow: var(--zak-shadow-lg); padding: var(--zak-space-1); }
.zak-context-menu.zak-contextmenu-active { display: block; position: fixed; }
.zak-menu-header { padding: 0.375rem 0.75rem; font-size: var(--zak-font-size-xs); font-weight: var(--zak-font-weight-semibold); color: var(--zak-text-muted); text-transform: uppercase; letter-spacing: 0.05em; }
.zak-menu-item { display: flex; align-items: center; gap: var(--zak-space-2); padding: 0.5rem 0.75rem; font-size: var(--zak-font-size-sm); color: var(--zak-text); cursor: pointer; border-radius: var(--zak-radius-sm); }
.zak-menu-item:hover { background-color: rgba(59, 130, 246, 0.08); color: var(--zak-color-primary); }
.zak-menu-divider { height: 1px; margin: var(--zak-space-1) 0; background-color: var(--zak-border); }

/* ---------- File upload (JS dropzone + previews) ---------- */
.zak-file-upload-dropzone { position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: var(--zak-space-2); min-height: 8rem; padding: var(--zak-space-5); border: 2px dashed var(--zak-border); border-radius: var(--zak-radius-lg); background-color: var(--zak-surface-muted, rgba(0, 0, 0, 0.02)); text-align: center; cursor: pointer; }
.zak-file-upload-text { margin: 0; color: var(--zak-text-muted); }
.zak-file-preview {
  display: flex;
  flex-wrap: wrap;
  gap: var(--zak-space-2);
  margin-top: var(--zak-space-3);
}
.zak-file-preview .zak-file-preview-item {
  display: inline-flex;
  align-items: center;
  gap: var(--zak-space-2);
  padding: 0.25rem 0.625rem;
  font-size: var(--zak-font-size-xs);
  background-color: var(--zak-surface-hover);
  border: 1px solid var(--zak-border);
  border-radius: var(--zak-radius-md);
}
.zak-file-upload-dropzone:hover { border-color: var(--zak-color-primary); }
.zak-file-input { cursor: pointer; }
.zak-file-input::file-selector-button { margin-right: var(--zak-space-2); padding: 0.375rem 0.75rem; font-family: var(--zak-font-sans); font-size: var(--zak-font-size-sm); color: var(--zak-text); background-color: var(--zak-bg-subtle); border: 1px solid var(--zak-border); border-radius: var(--zak-radius-md); cursor: pointer; transition: background-color var(--zak-transition-fast); }
.zak-file-input::file-selector-button:hover { background-color: var(--zak-surface-hover); }
.zak-fileupload-dragover { border-color: var(--zak-color-primary) !important; background-color: rgba(59, 130, 246, 0.06) !important; }
.zak-fileupload-previews { display: flex; flex-direction: column; gap: var(--zak-space-2); width: 100%; }
.zak-fileupload-item { display: flex; align-items: center; gap: var(--zak-space-3); padding: 0.5rem 0.75rem; background-color: var(--zak-surface-muted, rgba(0, 0, 0, 0.03)); border-radius: var(--zak-radius-md); font-size: var(--zak-font-size-sm); }
.zak-fileupload-thumb { width: 2.5rem; height: 2.5rem; object-fit: cover; border-radius: var(--zak-radius-sm); flex: none; }
.zak-fileupload-name { flex: 1; color: var(--zak-text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.zak-fileupload-size { color: var(--zak-text-muted); font-size: var(--zak-font-size-xs); }
.zak-fileupload-remove { border: 0; background: none; color: var(--zak-text-muted); font-size: 1.1rem; line-height: 1; cursor: pointer; }
.zak-fileupload-remove:hover { color: var(--zak-color-danger); }

/* ---------- Loading button ---------- */
.zak-loading-btn-active { opacity: 0.7; cursor: progress; pointer-events: none; }
.zak-loading-btn-spinner { display: inline-block; width: 1rem; height: 1rem; border: 2px solid transparent; border-top-color: currentColor; border-radius: 50%; animation: zak-ui-spin 0.6s linear infinite; vertical-align: -2px; }

/* ---------- Navbar (responsive toggle) ---------- */
.zak-navbar-toggle { display: inline-flex; align-items: center; justify-content: center; width: 2.5rem; height: 2.5rem; border: 0; background: none; border-radius: var(--zak-radius-md); cursor: pointer; color: var(--zak-text); }
@media (max-width: 767.98px) {
  .zak-navbar-toggle { display: inline-flex; }
  .zak-navbar.zak-navbar-active .zak-navbar-collapse,
  .zak-navbar.zak-navbar-active .zak-navbar-menu,
  .zak-navbar-menu.zak-navbar-menu-active { display: flex; width: 100%; }
}
.zak-navbar-placeholder { height: 4rem; }

/* ---------- Sidebar (toggle + overlay) ---------- */
.zak-sidebar.zak-sidebar-active { transform: translateX(0); }
.zak-sidebar-close { display: inline-flex; align-items: center; justify-content: center; width: 2rem; height: 2rem; border: 0; background: none; border-radius: var(--zak-radius-md); cursor: pointer; color: var(--zak-text-muted); font-size: 1.25rem; line-height: 1; }
.zak-sidebar-close:hover { color: var(--zak-text); background-color: var(--zak-surface-muted, rgba(0, 0, 0, 0.04)); }
.zak-sidebar-overlay { position: fixed; inset: 0; background-color: rgba(0, 0, 0, 0.45); opacity: 0; pointer-events: none; transition: opacity var(--zak-transition-base); z-index: var(--zak-z-overlay, 900); }
.zak-sidebar-overlay.zak-sidebar-overlay-active { opacity: 1; pointer-events: auto; }

/* ---------- Progress circle (JS-built SVG) ---------- */
.zak-progress-circle { position: relative; display: inline-flex; align-items: center; justify-content: center; }
.zak-progress-circle-svg { transform: rotate(-90deg); }
.zak-progress-circle-svg circle:first-child { stroke: var(--zak-border); }
.zak-progress-circle .zak-progress-circle-bar { stroke: var(--zak-color-primary); stroke-linecap: round; transition: stroke-dashoffset var(--zak-transition-slow); }
.zak-progress-circle .zak-progress-circle-label { position: absolute; font-size: var(--zak-font-size-sm); font-weight: var(--zak-font-weight-semibold); color: var(--zak-text); }

/* ---------- Show more ---------- */
.zak-showmore-truncated::after { content: ''; position: absolute; inset-inline: 0; bottom: 0; height: 2rem; background: linear-gradient(transparent, var(--zak-surface)); pointer-events: none; }
.zak-showmore-expanded { overflow: visible; }

/* ---------- Toast / Snackbar transitions ---------- */
.zak-toast.zak-toast-active { animation: zak-ui-toast-in 0.3s ease both; }
.zak-toast.zak-toast-dismissing { opacity: 0; transform: translateY(0.5rem); pointer-events: none; }
.zak-snackbar.zak-snackbar-active { animation: zak-ui-snack-in 0.3s ease both; }

/* ---------- Stepper upcoming state ---------- */
.zak-stepper-step.upcoming .zak-stepper-dot { background-color: var(--zak-surface); border-color: var(--zak-border); color: var(--zak-text-muted); }
.zak-stepper-step.upcoming .zak-stepper-label { color: var(--zak-text-muted); }
.zak-stepper-step.upcoming:not(:first-child)::before { background-color: var(--zak-border); }

/* ---------- Copy code success ---------- */
.zak-docs-copy-btn.zak-copycode-btn-copied,
.docs-copy-btn.zak-copycode-btn-copied,
.zak-copycode-btn.zak-copycode-btn-copied { color: #16a34a; border-color: #16a34a; background-color: rgba(22, 163, 74, 0.08); }

@keyframes zak-ui-spin { to { transform: rotate(360deg); } }
@keyframes zak-ui-toast-in { from { opacity: 0; transform: translateY(-0.75rem); } to { opacity: 1; transform: translateY(0); } }
@keyframes zak-ui-snack-in { from { opacity: 0; transform: translateX(-50%) translateY(0.75rem); } to { opacity: 1; transform: translateX(-50%) translateY(0); } }

.zak-accordion-body.zak-accordion-content-active { overflow: hidden; }
.zak-cascader-option-parent { font-weight: var(--zak-font-weight-medium); }

.zak-sidebar-offscreen { transform: translateX(-105%); }

/* ============================================================
   ZAKUIKit — Additions: button variants, form field variants,
   picker/widget media styles, lightbox, compare, responsive navbar
   ============================================================ */

/* ---------- Button variants (light / dark) ---------- */
.zak-btn-light {
  color: #1f2937;
  background-color: #f9fafb;
  border-color: #d1d5db;
}
.zak-btn-light:hover { background-color: #f3f4f6; color: #111827; border-color: #9ca3af; }
.zak-btn-light:focus-visible { box-shadow: 0 0 0 0.2rem rgba(17, 24, 39, 0.15); }

.zak-btn-dark {
  color: #f9fafb;
  background-color: #111827;
  border-color: #111827;
}
.zak-btn-dark:hover { background-color: #1f2937; color: #ffffff; border-color: #1f2937; }
.zak-btn-dark:focus-visible { box-shadow: 0 0 0 0.2rem rgba(17, 24, 39, 0.35); }

/* ---------- Form field / input variants ---------- */
.zak-input--filled,
.zak-input[data-variant="filled"] {
  background-color: var(--zak-bg-subtle, #f1f5f9);
  border-color: transparent;
}
.zak-input--filled:hover,
.zak-input[data-variant="filled"]:hover { border-color: transparent; }
.zak-input--filled:focus,
.zak-input[data-variant="filled"]:focus {
  background-color: var(--zak-secondary-50, #f9fafb);
  border-color: var(--zak-color-primary, #3b82f6);
}

.zak-input--outlined,
.zak-input[data-variant="outlined"] {
  background-color: transparent;
  border: 2px solid var(--zak-border-strong, #94a3b8);
}
.zak-input--outlined:focus,
.zak-input[data-variant="outlined"]:focus { border-color: var(--zak-color-primary, #3b82f6); }

.zak-input--underline,
.zak-input[data-variant="underline"] {
  border: 0;
  border-bottom: 2px solid var(--zak-border-strong, #cbd5e1);
  border-radius: 0;
  padding-left: 0;
  padding-right: 0;
  background-color: transparent;
}
.zak-input--underline:hover,
.zak-input[data-variant="underline"]:hover { border-bottom-color: var(--zak-color-primary, #3b82f6); }
.zak-input--underline:focus,
.zak-input[data-variant="underline"]:focus {
  box-shadow: none;
  border-bottom-color: var(--zak-color-primary, #3b82f6);
}

.zak-input--ghost,
.zak-input[data-variant="ghost"] {
  border-color: transparent;
  background-color: transparent;
}
.zak-input--ghost:hover,
.zak-input[data-variant="ghost"]:hover { background-color: var(--zak-bg-subtle, #f1f5f9); }
.zak-input--ghost:focus,
.zak-input[data-variant="ghost"]:focus { background-color: var(--zak-bg-subtle, #f1f5f9); box-shadow: none; }

/* ---------- Slider widget (data-zak-slider) ---------- */
.zak-slider > .zak-slider-track {
  position: relative;
  height: 6px;
  background-color: var(--zak-bg-subtle, #e2e8f0);
  border-radius: 999px;
  overflow: visible;
}
.zak-slider > .zak-slider-track > .zak-slider-fill {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  background-color: var(--zak-color-primary, #3b82f6);
  border-radius: 999px;
}
.zak-slider > .zak-slider-thumb {
  position: absolute;
  top: -5px;
  width: 16px;
  height: 16px;
  margin-left: -8px;
  border-radius: 50%;
  background-color: #ffffff;
  border: 2px solid var(--zak-color-primary, #3b82f6);
  box-shadow: 0 1px 4px rgba(15, 23, 42, 0.25);
  cursor: grab;
  touch-action: none;
}
.zak-slider > .zak-slider-thumb:active { cursor: grabbing; }
.zak-slider > .zak-slider-thumb:focus-visible { outline: 2px solid var(--zak-color-primary, #3b82f6); outline-offset: 2px; }

/* ---------- Pickers: fine-tuning ---------- */
.zak-month-header,
.zak-year-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  margin-bottom: 10px;
}
.zak-month-prev, .zak-month-next,
.zak-year-prev, .zak-year-next {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 2rem;
  height: 2rem;
  background: var(--zak-bg-subtle, #f1f5f9);
  border: 1px solid var(--zak-border, #e2e8f0);
  border-radius: 8px;
  cursor: pointer;
  color: var(--zak-text, #1e293b);
}
.zak-month-prev:hover, .zak-month-next:hover,
.zak-year-prev:hover, .zak-year-next:hover { border-color: var(--zak-color-primary, #3b82f6); color: var(--zak-color-primary, #3b82f6); }
.zak-month-year, .zak-year-range { font-weight: 600; font-size: 14px; color: var(--zak-text, #1e293b); }

.zak-year-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; }

.zak-range-calendars { display: flex; gap: 16px; flex-wrap: wrap; }
.zak-range-popup .zak-calendar,
.zak-datetime-cal .zak-calendar { box-shadow: none; border: 0; padding: 0; min-width: 0; }
.zak-range-in-range { background: var(--zak-primary-100, #dbeafe); }

.zak-datetime-select {
  padding: 6px 8px;
  border: 1px solid var(--zak-border, #e2e8f0);
  border-radius: 8px;
  background: var(--zak-surface, #ffffff);
  font-size: 14px;
  color: var(--zak-text, #1e293b);
  min-width: 4.5rem;
}
.zak-datetime-select:focus { outline: none; border-color: var(--zak-color-primary, #3b82f6); }
.zak-datetime-label { font-size: 12px; color: var(--zak-text-muted, #64748b); }

/* ---------- Lightbox ---------- */
.zak-lightbox {
  position: fixed;
  inset: 0;
  z-index: 9999;
  background-color: rgba(2, 6, 23, 0.86);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: opacity 0.16s ease;
}
.zak-lightbox-active { opacity: 1; }
.zak-lightbox-box { position: relative; max-width: min(92vw, 1000px); max-height: 92vh; }
.zak-lightbox-close {
  position: absolute;
  top: -2.75rem;
  right: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 2.25rem;
  height: 2.25rem;
  border: 0;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
  color: #ffffff;
  font-size: 1.5rem;
  line-height: 1;
  cursor: pointer;
}
.zak-lightbox-close:hover { background: rgba(255, 255, 255, 0.22); }
.zak-lightbox-figure { margin: 0; }
.zak-lightbox-figure img {
  display: block;
  max-width: 92vw;
  max-height: 86vh;
  object-fit: contain;
  border-radius: 10px;
}
.zak-lightbox-caption { margin-top: 0.75rem; text-align: center; color: #cbd5e1; font-size: 14px; }

/* ---------- Compare slider ---------- */
.zak-compare { position: relative; overflow: hidden; cursor: ew-resize; user-select: none; }
.zak-compare-image { display: block; width: 100%; height: 100%; object-fit: cover; }
.zak-compare .zak-compare-before { position: absolute; inset: 0; }
.zak-compare .zak-compare-after { position: absolute; inset: 0; clip-path: inset(0 50% 0 0); }
.zak-compare-divider {
  position: absolute;
  top: 0;
  bottom: 0;
  width: 2px;
  background-color: rgba(255, 255, 255, 0.95);
  box-shadow: 0 0 12px rgba(0, 0, 0, 0.55);
  touch-action: none;
  z-index: 3;
}
.zak-compare-handle {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  align-items: center;
  justify-content: center;
  width: 2.5rem;
  height: 2.5rem;
  border-radius: 50%;
  background-color: #ffffff;
  color: #0f172a;
  font-size: 1.1rem;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.35);
}

/* ---------- Navbar: Bootstrap-style responsive collapse ---------- */
.zak-navbar-toggle .zak-navbar-toggle-icon {
  display: block;
  width: 1.25rem;
  height: 2px;
  margin: 4px 0;
  background-color: currentColor;
  border-radius: 2px;
  transition: transform var(--zak-transition-fast, 150ms), opacity var(--zak-transition-fast, 150ms);
}
.zak-navbar.zak-navbar-active .zak-navbar-toggle-icon:nth-child(1) { transform: rotate(45deg) translateY(6px); }
.zak-navbar.zak-navbar-active .zak-navbar-toggle-icon:nth-child(2) { opacity: 0; }
.zak-navbar.zak-navbar-active .zak-navbar-toggle-icon:nth-child(3) { transform: rotate(-45deg) translateY(-6px); }

@media (max-width: 991.98px) {
  .zak-navbar.zak-navbar-active .zak-navbar-toggle-icon:nth-child(1) { transform: rotate(45deg) translateY(6px); }
  .zak-navbar.zak-navbar-active .zak-navbar-toggle-icon:nth-child(2) { opacity: 0; }
  .zak-navbar.zak-navbar-active .zak-navbar-toggle-icon:nth-child(3) { transform: rotate(-45deg) translateY(-6px); }
}

/* ---------- Cascader dropdown ---------- */

/* ---------- Cascader dropdown ---------- */
.zak-cascader-menu {
  position: absolute;
  z-index: 60;
  margin-top: 6px;
  min-width: 180px;
  padding: 6px;
  background: var(--zak-surface, #ffffff);
  border: 1px solid var(--zak-border, #e2e8f0);
  border-radius: 12px;
  box-shadow: 0 10px 24px rgba(15, 23, 42, 0.12);
}

/* ---------- Carousel: fade + multi (per page) ---------- */
.zak-carousel-fade .zak-carousel-inner { position: absolute; inset: 0; }
.zak-carousel-fade .zak-carousel-item, .zak-carousel-fade .zak-carousel-slide {
  position: absolute;
  inset: 0;
  min-width: 100%;
  opacity: 0;
  transition: opacity 0.5s ease;
}
.zak-carousel-fade .zak-carousel-item.zak-active, .zak-carousel-fade .zak-carousel-slide.zak-active { opacity: 1; }
.zak-carousel-multi .zak-carousel-item, .zak-carousel-multi .zak-carousel-slide { min-width: 50%; }

/* ============================================================
   ZAKUIKit Media components (video / image / gallery / audio)
   Added during docs repair: missing classes referenced on media pages.
   ============================================================ */
.zak-video-responsive { position: relative; width: 100%; overflow: hidden; }
.zak-video-responsive::before { display: block; content: ""; padding-top: 56.25%; }
.zak-video-responsive.zak-video-4by3::before { padding-top: 75%; }
.zak-video-16by9::before { padding-top: 56.25%; }
.zak-video-responsive.zak-video-1by1::before { padding-top: 100%; }
.zak-video-responsive.zak-video-21by9::before { padding-top: 42.857143%; }
.zak-video-responsive video,
.zak-video-responsive iframe { position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: 0; }
.zak-video-caption { margin-top: var(--zak-space-2); font-size: var(--zak-font-size-sm); color: var(--zak-text-muted); text-align: center; }

.zak-image-figure { margin: 0; }
.zak-image-figure .zak-image { display: block; }
.zak-image-caption { display: block; margin-top: var(--zak-space-2); font-size: var(--zak-font-size-sm); color: var(--zak-text-muted); text-align: center; }
.zak-image-bordered { border: 1px solid var(--zak-border); padding: var(--zak-space-2); }
.zak-image-border-dashed { border: 1px dashed var(--zak-border-strong); padding: var(--zak-space-2); }
.zak-image-circle { border-radius: var(--zak-radius-full); object-fit: cover; }
.zak-image-pill { border-radius: var(--zak-radius-full); }
.zak-image-overlay { position: relative; display: inline-block; overflow: hidden; border-radius: var(--zak-radius-lg); line-height: 0; }
.zak-image-overlay .zak-image { display: block; width: 100%; }
.zak-image-overlay-content { position: absolute; inset: auto 0 0 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: var(--zak-space-2); padding: var(--zak-space-4); color: #fff; background: linear-gradient(180deg, transparent, rgba(15, 23, 42, 0.75)); text-align: center; line-height: 1.4; }
.zak-image-placeholder { display: flex; align-items: center; justify-content: center; aspect-ratio: 16 / 9; width: 100%; background: var(--zak-bg-subtle); border: 1px dashed var(--zak-border-strong); border-radius: var(--zak-radius-lg); color: var(--zak-text-muted); font-size: var(--zak-font-size-sm); }
.zak-image-xs { width: 2rem; height: 2rem; }

.zak-gallery { display: grid; gap: var(--zak-space-4); }
.zak-gallery-2col { grid-template-columns: repeat(2, 1fr); }
.zak-gallery-3col { grid-template-columns: repeat(3, 1fr); }
.zak-gallery-4col { grid-template-columns: repeat(4, 1fr); }
.zak-gallery-item { position: relative; overflow: hidden; border-radius: var(--zak-radius-lg); }
.zak-gallery-item img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; display: block; }
.zak-gallery-masonry { columns: 3 220px; column-gap: var(--zak-space-4); }
.zak-gallery-masonry .zak-gallery-item { break-inside: avoid; margin-bottom: var(--zak-space-4); }
.zak-gallery-caption,
.zak-gallery-item-caption { position: absolute; inset: auto 0 0 0; padding: var(--zak-space-2) var(--zak-space-3); background: rgba(15, 23, 42, 0.65); color: #fff; font-size: var(--zak-font-size-xs); text-align: center; }
.zak-gallery-count { position: absolute; top: var(--zak-space-2); right: var(--zak-space-2); padding: 2px 8px; background: rgba(15, 23, 42, 0.7); color: #fff; font-size: var(--zak-font-size-xs); border-radius: var(--zak-radius-full); }
.zak-gallery-thumbnails { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--zak-space-2); }
.zak-gallery-thumbnails img { width: 100%; aspect-ratio: 1 / 1; object-fit: cover; border-radius: var(--zak-radius-md); cursor: pointer; }

.zak-audio-custom { display: flex; align-items: center; gap: var(--zak-space-3); padding: var(--zak-space-4); background: var(--zak-surface); border: 1px solid var(--zak-border); border-radius: var(--zak-radius-lg); }
.zak-audio-artwork { width: 3.5rem; height: 3.5rem; flex-shrink: 0; display: flex; align-items: center; justify-content: center; border-radius: var(--zak-radius-md); background: var(--zak-bg-subtle); }
.zak-audio-info { min-width: 0; flex: 1; }
.zak-audio-info strong { display: block; font-size: var(--zak-font-size-sm); }
.zak-audio-info span { font-size: var(--zak-font-size-xs); color: var(--zak-text-muted); }
.zak-audio-play { width: 2.5rem; height: 2.5rem; flex-shrink: 0; display: inline-flex; align-items: center; justify-content: center; border-radius: var(--zak-radius-full); border: 0; background: var(--zak-color-primary, #4f46e5); color: #fff; cursor: pointer; }
.zak-audio-play:hover { filter: brightness(1.1); }
.zak-audio-progress { flex: 1; height: 4px; background: var(--zak-border); border-radius: 2px; overflow: hidden; }
.zak-audio-progress-bar { height: 100%; width: 38%; background: var(--zak-color-primary, #4f46e5); border-radius: 2px; }
.zak-audio-waveform { display: flex; align-items: center; gap: 2px; height: 3rem; }
.zak-audio-waveform-bar { flex: 1; border-radius: 2px; background: var(--zak-color-primary, #4f46e5); }
.zak-audio-playlist { list-style: none; margin: 0; padding: 0; }
.zak-audio-playlist-tracklist { border-top: 1px solid var(--zak-border); }
.zak-audio-track { display: flex; align-items: center; gap: var(--zak-space-3); padding: var(--zak-space-3); border-bottom: 1px solid var(--zak-border); }
.zak-audio-track.zak-active { background: rgba(99, 102, 241, 0.08); }
