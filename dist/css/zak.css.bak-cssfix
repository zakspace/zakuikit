/* ============================================================
   14. VISIBILITY / OPACITY UTILITIES
   ============================================================ */
.zak-visible { visibility: visible; }
.zak-invisible { visibility: hidden; }
.zak-collapse { visibility: collapse; }
.zak-opacity-0 { opacity: 0; }
.zak-opacity-25 { opacity: 0.25; }
.zak-opacity-50 { opacity: 0.5; }
.zak-opacity-75 { opacity: 0.75; }
.zak-opacity-100 { opacity: 1; }

.zak-user-select-none { user-select: none; }
.zak-user-select-text { user-select: text; }
.zak-user-select-all { user-select: all; }

.zak-pe-none { pointer-events: none; }
.zak-pe-auto { pointer-events: auto; }

/* ============================================================
