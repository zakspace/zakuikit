.zak-inset-0 { inset: 0; }
.zak-inset-50 { inset: 50%; }
.zak-inset-auto { inset: auto; }
.zak-translate-middle { transform: translate(-50%, -50%); }
.zak-translate-middle-x { transform: translateX(-50%); }
.zak-translate-middle-y { transform: translateY(-50%); }

.zak-relative { position: relative; }
.zak-absolute { position: absolute; }
.zak-fixed { position: fixed; }
.zak-sticky { position: sticky; top: 0; }

