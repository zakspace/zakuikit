.zak-py-8 { padding-top: var(--zak-space-8); padding-bottom: var(--zak-space-8); }

.zak-pt-0 { padding-top: var(--zak-space-0); }
.zak-pt-1 { padding-top: var(--zak-space-1); }
.zak-pt-2 { padding-top: var(--zak-space-2); }
.zak-pt-3 { padding-top: var(--zak-space-3); }
.zak-pt-4 { padding-top: var(--zak-space-4); }
.zak-pt-5 { padding-top: var(--zak-space-5); }
