.zak-overflow-y-scroll { overflow-y: scroll; }

.zak-truncate { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.zak-line-clamp-1 { display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden; }
.zak-line-clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.zak-line-clamp-3 { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
.zak-line-clamp-4 { display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden; }

/* ============================================================
   13. CURSOR UTILITIES
   ============================================================ */
.zak-cursor-auto { cursor: auto; }
.zak-cursor-default { cursor: default; }
.zak-cursor-pointer { cursor: pointer; }
.zak-cursor-wait { cursor: wait; }
.zak-cursor-text { cursor: text; }
.zak-cursor-move { cursor: move; }
.zak-cursor-not-allowed { cursor: not-allowed; }
.zak-cursor-grab { cursor: grab; }
.zak-cursor-grabbing { cursor: grabbing; }
.zak-cursor-help { cursor: help; }
.zak-cursor-progress { cursor: progress; }
.zak-cursor-cell { cursor: cell; }
